#!/bin/sh
# Одноразовое обновление файлов и пользовательской стратегии nfqws.
set -eu

DIR=/opt/etc/nfqws
CONFIG="$DIR/nfqws.conf"
API='https://api.github.com/repos/thenem1roff/keenutils/contents/nfqws_files?ref=main'
FILES_URL='https://raw.githubusercontent.com/thenem1roff/keenutils/main/nfqws_files'
STRATEGY_URL='https://raw.githubusercontent.com/thenem1roff/keenutils/main/strategy'

fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }

# Проверяем значение именно NFQWS_ARGS_CUSTOM, включая многострочную стратегию.
# Конфигурацию не выполняем как shell-код.
verify_saved_strategy() {
    awk -v expected="$STRATEGY" '
        function quote_pos(s,    i) {
            for (i=1; i<=length(s); i++)
                if (substr(s,i,1)=="\"") return i
            return 0
        }
        inside {
            pos=quote_pos($0)
            if (pos) {
                value=value substr($0,1,pos-1)
                inside=0
                complete=1
            } else {
                value=value $0 "\n"
            }
            next
        }
        /^[ \t]*NFQWS_ARGS_CUSTOM[ \t]*=/ {
            seen++
            if (seen>1 || !match($0,/^[ \t]*NFQWS_ARGS_CUSTOM[ \t]*=[ \t]*"/)) {
                invalid=1
                exit
            }
            rest=substr($0,RLENGTH+1)
            pos=quote_pos(rest)
            if (pos) {
                value=substr(rest,1,pos-1)
                complete=1
            } else {
                value=rest "\n"
                inside=1
            }
        }
        END {
            if (invalid || seen!=1 || inside || !complete || value!=expected)
                exit 1
        }
    ' "$CONFIG"
}

# Перед изменением конфига проверяем файлы, указанные в новой стратегии.
# Не останавливаем работающую службу, если в стратегии не хватает файлов.
verify_strategy_files() {
    awk '
        {
            for (i=1; i<=NF; i++) {
                arg=$i
                if (arg ~ /^--(hostlist|hostlist-exclude|ipset|ipset-exclude|dpi-desync-fake-[^=]+|dpi-desync-split-seqovl-pattern)=\/opt\//) {
                    pos=index(arg,"=")
                    path=substr(arg,pos+1)
                    if (!seen[path]++) print path
                }
            }
        }
    ' "$TMP/strategy" > "$TMP/strategy.paths" ||
        fail 'Не удалось проверить пути файлов в стратегии'

    missing=0
    while IFS= read -r file; do
        if [ ! -f "$file" ] || [ ! -r "$file" ]; then
            printf 'Отсутствует или недоступен файл стратегии: %s\n' "$file" >&2
            missing=1
        fi
    done < "$TMP/strategy.paths"
    [ "$missing" -eq 0 ] ||
        fail 'Не все файлы стратегии доступны. Восстановите их или обновите nfqws_files и повторите запуск'
}

# Читаем ответы с терминала: стандартный ввод занят самим скриптом (curl | sh).
# Пустой ответ означает "да"; удаляем CR для совместимости с терминалами.
confirm_yes() {
    [ -r /dev/tty ] || fail 'Не найден терминал для подтверждения'
    while :; do
        printf '%s [Y/n]: ' "$1" > /dev/tty
        IFS= read -r reply </dev/tty || fail 'Не удалось прочитать ответ'
        reply=$(printf '%s' "$reply" | tr -d '\r')
        case "$reply" in
            ''|y|Y|yes|YES|д|Д|да|ДА) return 0 ;;
            n|N|no|NO|н|Н|нет|НЕТ) return 1 ;;
            *) printf 'Непонятный ответ. Введите y или n.\n' > /dev/tty ;;
        esac
    done
}

# Такой же вопрос, но Enter означает "нет": не засоряем консоль текстом стратегии.
confirm_no() {
    [ -r /dev/tty ] || fail 'Не найден терминал для подтверждения'
    while :; do
        printf '%s [y/N]: ' "$1" > /dev/tty
        IFS= read -r reply </dev/tty || fail 'Не удалось прочитать ответ'
        reply=$(printf '%s' "$reply" | tr -d '\r')
        case "$reply" in
            y|Y|yes|YES|д|Д|да|ДА) return 0 ;;
            ''|n|N|no|NO|н|Н|нет|НЕТ) return 1 ;;
            *) printf 'Непонятный ответ. Введите y или n.\n' > /dev/tty ;;
        esac
    done
}

# nfqws-keenetic: исполняемый файл, конфигурация и init-скрипт Entware.
# nfqws-keenetic-web не имеет своего исполняемого файла: это веб-сайт lighttpd.
NFQWS_BIN=/opt/usr/bin/nfqws
WEB_INDEX=/opt/share/www/nfqws/index.html
WEB_CONFIG=/opt/etc/nfqws_web.conf

package_installed() {
    command -v opkg >/dev/null 2>&1 || return 1
    opkg list-installed "$1" 2>/dev/null |
        awk -v pkg="$1" '$1==pkg && $2=="-" {found=1} END {exit !found}'
}

nfqws_files_present() {
    [ -x "$NFQWS_BIN" ] && [ -f "$CONFIG" ] || return 1
    for init in /opt/etc/init.d/S*nfqws*; do
        [ -x "$init" ] && return 0
    done
    return 1
}

web_files_present() {
    [ -f "$WEB_INDEX" ] && [ -f "$WEB_CONFIG" ]
}

# Проверяем фиксированные пути и статус пакетов; полный поиск на флешке не нужен.
printf 'Проверка установки nfqws-keenetic и nfqws-keenetic-web...\n'
MISSING_NFQWS=0
MISSING_WEB=0
nfqws_files_present || MISSING_NFQWS=1
web_files_present || MISSING_WEB=1
if command -v opkg >/dev/null 2>&1; then
    package_installed nfqws-keenetic || MISSING_NFQWS=1
    package_installed nfqws-keenetic-web || MISSING_WEB=1
fi

if [ "$MISSING_NFQWS" -eq 0 ]; then
    printf 'nfqws-keenetic: установлен (%s).\n' "$NFQWS_BIN"
else
    printf 'nfqws-keenetic: не найден или установлен неполностью.\n'
    printf 'Проверяемые пути: %s, %s и /opt/etc/init.d/S*nfqws*\n' "$NFQWS_BIN" "$CONFIG"
fi
if [ "$MISSING_WEB" -eq 0 ]; then
    printf 'nfqws-keenetic-web: установлен (%s).\n' "$WEB_INDEX"
else
    printf 'nfqws-keenetic-web: не найден или установлен неполностью.\n'
    printf 'Проверяемые пути: %s, %s\n' "$WEB_INDEX" "$WEB_CONFIG"
fi

if [ "$MISSING_NFQWS" -eq 1 ] || [ "$MISSING_WEB" -eq 1 ]; then
    if ! confirm_yes 'Установить nfqws-keenetic и nfqws-keenetic-web через opkg?'; then
        printf 'Установка отменена. Изменения не внесены.\n'
        exit 0
    fi

    command -v opkg >/dev/null 2>&1 || fail 'Не найден opkg: для установки нужен Entware'
    printf '\nУстановка зависимостей...\n'
    opkg update || fail 'Ошибка opkg update'
    opkg install ca-certificates wget-ssl jq || fail 'Ошибка установки зависимостей'
    # Если wget-nossl отсутствует, удалять нечего.
    if package_installed wget-nossl; then
        opkg remove wget-nossl 2>/dev/null || fail 'Не удалось удалить wget-nossl'
    fi

    mkdir -p /opt/etc/opkg || fail 'Не удалось создать /opt/etc/opkg'
    printf '%s\n' 'src/gz nfqws-keenetic https://nfqws.github.io/nfqws-keenetic/all' > /opt/etc/opkg/nfqws-keenetic.conf ||
        fail 'Не удалось добавить репозиторий nfqws-keenetic'
    printf '%s\n' 'src/gz nfqws-keenetic-web https://nfqws.github.io/nfqws-keenetic-web/all' > /opt/etc/opkg/nfqws-keenetic-web.conf ||
        fail 'Не удалось добавить репозиторий nfqws-keenetic-web'

    opkg update || fail 'Не удалось обновить список новых репозиториев'
    opkg install nfqws-keenetic nfqws-keenetic-web || fail 'Не удалось установить nfqws-keenetic и nfqws-keenetic-web'

    package_installed nfqws-keenetic || fail 'opkg не подтверждает установку nfqws-keenetic'
    package_installed nfqws-keenetic-web || fail 'opkg не подтверждает установку nfqws-keenetic-web'
    nfqws_files_present || fail "После установки не найдены $NFQWS_BIN, $CONFIG или init-скрипт"
    web_files_present || fail "После установки не найдены $WEB_INDEX или $WEB_CONFIG"
    printf 'Оба пакета установлены и проверены.\n'
fi

[ -d "$DIR" ] || fail "Не найдена папка $DIR"
[ -f "$CONFIG" ] || fail "Не найден конфиг $CONFIG"
for program in curl jq awk mktemp tr cmp; do
    command -v "$program" >/dev/null 2>&1 || fail "Не найдена команда $program"
done

TMP=$(mktemp -d "$DIR/.nfqws-update.XXXXXX") || fail 'Не удалось создать временную папку'
trap 'rm -rf "$TMP"' 0
trap 'exit 130' 2
trap 'exit 143' 15

# Файл strategy хранится в корне репозитория, а не в nfqws_files.
curl -fsSL --retry 2 "$STRATEGY_URL" -o "$TMP/strategy" || fail 'Не удалось скачать strategy'
[ -s "$TMP/strategy" ] || fail 'Файл strategy пустой'

# Сохраняем все внутренние переводы строк в точности как в strategy.
# Только завершающий перевод строки файла не включается в значение параметра.
# Не допускаем опасных для shell-конфига подстановок или кавычек.
awk '
    index($0,"\"") || index($0,"\\") || index($0,"$") || index($0,"`") { exit 1 }
' "$TMP/strategy" || fail 'Недопустимые символы в strategy: кавычки, обратный слеш, $, `'
STRATEGY=$(cat "$TMP/strategy")
[ -n "$STRATEGY" ] || fail 'В strategy нет аргументов'

# Меняем только значение NFQWS_ARGS_CUSTOM; остальные строки не редактируем.
# Поддерживаются одно- и многострочные значения в двойных кавычках.
awk -v new="$STRATEGY" -v oldfile="$TMP/current" '
    function endquote(s, start,    i, c, escape) {
        escape=0
        for (i=start; i<=length(s); i++) {
            c=substr(s,i,1)
            if (c=="\\" && !escape) { escape=1; continue }
            if (c=="\"" && !escape) return i
            escape=0
        }
        return 0
    }
    /^[ \t]*NFQWS_ARGS_CUSTOM[ \t]*=/ {
        seen++
        if (seen>1 || !match($0, /^[ \t]*NFQWS_ARGS_CUSTOM[ \t]*=[ \t]*"/)) {
            bad=1
            exit
        }
        prefix=substr($0,1,RLENGTH)
        value=substr($0,RLENGTH+1)
        pos=endquote(value,1)
        if (pos) {
            old=substr(value,1,pos-1)
            print prefix new "\"" substr(value,pos+1)
        } else {
            old=value "\n"
            pending=prefix
            inside=1
        }
        next
    }
    inside {
        pos=endquote($0,1)
        if (pos) {
            old=old substr($0,1,pos-1)
            print pending new "\"" substr($0,pos+1)
            inside=0
        } else {
            old=old $0 "\n"
        }
        next
    }
    { print }
    END {
        if (bad || seen!=1 || inside) {
            print "Не удалось однозначно найти NFQWS_ARGS_CUSTOM в двойных кавычках" > "/dev/stderr"
            exit 1
        }
        printf "%s", old > oldfile
    }
' "$CONFIG" > "$TMP/config.edited" || fail 'Конфигурация не изменена'

CURRENT=$(cat "$TMP/current")
UPDATE_STRATEGY=0
UPDATE_FILES=0

if [ "$CURRENT" = "$STRATEGY" ]; then
    printf 'Стратегия уже совпадает с GitHub. Изменять nfqws.conf не требуется.\n'
    if confirm_no 'Показать текст стратегии?'; then
        printf '\nСтратегия:\n%s\n\n' "$STRATEGY"
    fi
elif [ -z "$CURRENT" ]; then
    printf '\nNFQWS_ARGS_CUSTOM пуст.\n'
    if confirm_no 'Показать новую стратегию?'; then
        printf '\nНовая стратегия:\n%s\n\n' "$STRATEGY"
    fi
    if confirm_yes 'Добавить стратегию в NFQWS_ARGS_CUSTOM?'; then
        UPDATE_STRATEGY=1
    fi
else
    printf '\nСтратегия в nfqws.conf отличается от GitHub.\n'
    if confirm_no 'Показать текущую и новую стратегии?'; then
        printf '\nТекущая стратегия:\n%s\n\nНовая стратегия:\n%s\n\n' "$CURRENT" "$STRATEGY"
    fi
    if confirm_yes 'Заменить NFQWS_ARGS_CUSTOM?'; then
        UPDATE_STRATEGY=1
    fi
fi

# Обновление файлов — отдельный выбор независимо от стратегии.
if confirm_yes 'Обновить файлы nfqws_files?'; then
    UPDATE_FILES=1
fi

if [ "$UPDATE_STRATEGY" -eq 0 ] && [ "$UPDATE_FILES" -eq 0 ]; then
    printf 'Отменено. Файлы и конфигурация не изменены.\n'
    exit 0
fi

if [ "$UPDATE_FILES" -eq 1 ]; then
# Заранее скачиваем все файлы, не заменяя существующие при ошибке загрузки.
curl -fsSL --retry 2 "$API" -o "$TMP/manifest.json" || fail 'Не удалось получить список файлов'
jq -er 'if type=="array" then [.[] | select(.type=="file") | .name] | .[] else error("wrong response") end' \
    "$TMP/manifest.json" > "$TMP/files.txt" || fail 'Неверный список файлов GitHub'
[ -s "$TMP/files.txt" ] || fail 'Папка nfqws_files пуста'

COUNT=0
while IFS= read -r name; do
    case "$name" in
        ''|.|..|*[!a-zA-Z0-9._-]*) fail "Недопустимое имя файла: $name" ;;
    esac
    printf 'Скачивание: %s\n' "$name"
    curl -fsSL --retry 2 "$FILES_URL/$name" -o "$TMP/$name" || fail "Не удалось скачать $name"
    chmod 644 "$TMP/$name" || fail "Не удалось установить права на $name"
    COUNT=$((COUNT+1))
done < "$TMP/files.txt"

# Атомарная замена каждого файла (TMP расположен на том же файловом разделе).
while IFS= read -r name; do
    mv -f "$TMP/$name" "$DIR/$name" || fail "Не удалось заменить $name"
done < "$TMP/files.txt"
printf '\nОбновлено файлов: %s\n' "$COUNT"
else
    printf 'Обновление файлов пропущено по выбору пользователя.\n'
fi

if [ "$UPDATE_STRATEGY" -eq 0 ]; then
    printf 'NFQWS_ARGS_CUSTOM не изменён. Перезапуск nfqws не требуется.\n'
    exit 0
fi

# Проверяем файлы до перезапуска и записи стратегии в рабочий конфиг.
verify_strategy_files

# Копирование с сохранением прав, затем атомарная замена конфига.
cp -p "$CONFIG" "$TMP/config.ready" || fail 'Не удалось подготовить конфигурацию'
cat "$TMP/config.edited" > "$TMP/config.ready" || fail 'Не удалось записать новую конфигурацию'
mv -f "$TMP/config.ready" "$CONFIG" || fail 'Не удалось заменить nfqws.conf'
cmp -s "$CONFIG" "$TMP/config.edited" || fail 'Сохранённый nfqws.conf отличается от подготовленного'
verify_saved_strategy || fail 'NFQWS_ARGS_CUSTOM не совпадает с новой стратегией в nfqws.conf'
printf 'NFQWS_ARGS_CUSTOM записан и проверен в nfqws.conf.\n'

# Перезапуск только после успешного изменения стратегии.
# Используем init-скрипт Entware, как в прежнем рабочем установщике.
INIT_NFQWS=''
for init in /opt/etc/init.d/S*nfqws*; do
    if [ -x "$init" ]; then
        INIT_NFQWS=$init
        break
    fi
done
[ -n "$INIT_NFQWS" ] || fail 'Скрипт запуска nfqws в /opt/etc/init.d не найден'
# Сохраняем весь вывод службы во временный журнал. Показываем его
# только при ошибке, чтобы успешный запуск не засорял консоль.
if ! "$INIT_NFQWS" restart > "$TMP/restart.log" 2>&1; then
    cat "$TMP/restart.log" >&2
    fail 'Команда перезапуска nfqws завершилась ошибкой'
fi

# nfqws запускается как демон: init-скрипт может вернуть успех, хотя
# дочерний процесс сразу завершился (например, из-за отсутствующего списка).
# Даем демону время запуститься и проверяем status два раза подряд.
sleep 2
if ! "$INIT_NFQWS" status > /dev/null 2>&1; then
    cat "$TMP/restart.log" >&2
    fail 'После перезапуска служба nfqws не работает'
fi
sleep 1
if ! "$INIT_NFQWS" status > /dev/null 2>&1; then
    cat "$TMP/restart.log" >&2
    fail 'После перезапуска служба nfqws остановилась'
fi

verify_saved_strategy || fail 'После перезапуска стратегия в nfqws.conf изменилась'
printf 'nfqws перезапущен. Служба работает, стратегия в nfqws.conf проверена.\n'
