#!/bin/sh
# KeenUtils Flowseal converter bootstrap. Standalone module, no Python.
# A child process of install; exit returns to menu 77 caller.
set -u
umask 077
export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
REF=${KEENUTILS_FLOWSEAL_REF:-main}
case "$REF" in
    ''|/*|*..*|*//*|*[!a-zA-Z0-9._/-]*)
        printf 'Ошибка: некорректная ветка конвертера.\n' >&2; exit 1 ;;
esac
BASE="https://raw.githubusercontent.com/thenem1roff/keenutils/$REF"
if [ "$REF" = main ]; then
    HOME_DIR=/opt/etc/keenutils/flowseal
    LAUNCHER=/opt/bin/keenutils-flowseal
else
    # A completely separate development runtime and saved strategy storage.
    HOME_DIR=/opt/etc/keenutils/flowseal-dev
    LAUNCHER=/opt/bin/keenutils-flowseal-dev
fi
RUNTIME="$HOME_DIR/runtime"
CURRENT_FILE="$HOME_DIR/current.version"
TEMP_FILE=''
STAGE=''
cleanup() {
    [ -z "$TEMP_FILE" ] || rm -f "$TEMP_FILE"
    [ -z "$STAGE" ] || rm -rf "$STAGE"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
have() { command -v "$1" >/dev/null 2>&1; }
error() { printf 'Ошибка Flowseal: %s\n' "$*" >&2; }
fetch() {
    source=$1; dest=$2
    if have wget && wget -q -O "$dest" "$source" && [ -s "$dest" ]; then return 0; fi
    if have curl && curl -fLSs --connect-timeout 8 --max-time 75 -o "$dest" "$source" &&
        [ -s "$dest" ]; then return 0; fi
    return 1
}
valid_version() {
    case "$1" in ''|*[!a-zA-Z0-9._-]*|.*)return 1;;esac
    [ "${#1}" -le 64 ]
}
read_current() {
    CURRENT=''
    if [ -f "$CURRENT_FILE" ] && [ ! -L "$CURRENT_FILE" ]; then
        IFS= read -r CURRENT < "$CURRENT_FILE" || :
        valid_version "$CURRENT" || CURRENT=''
    fi
}
install_runtime() {
    version=$1
    STAGE=$(mktemp -d "$HOME_DIR/.flowseal-update.XXXXXX") || return 1
    for relative in flowseal_converter modules/flowseal/menu.sh \
                    modules/flowseal/validator.sh modules/flowseal/converter.awk \
                    modules/flowseal/hostfakesplit_alt1.lua \
                    modules/flowseal/hostfakesplit_alt1.hex modules/flowseal/LICENSE; do
        target="$STAGE/${relative##*/}"
        if ! fetch "$BASE/$relative" "$target"; then
            error "Не удалось получить $relative";return 1
        fi
    done
    sh -n "$STAGE/flowseal_converter" && sh -n "$STAGE/menu.sh" &&
        sh -n "$STAGE/validator.sh" || return 1
    grep -Fq '# KeenUtils Flowseal converter bootstrap.' "$STAGE/flowseal_converter" ||
        { error 'Неверный формат загрузчика';return 1; }
    grep -Fq '# Independent Flowseal -> nfqws2 manager;' "$STAGE/menu.sh" ||
        { error 'Неверный формат модуля';return 1; }
    grep -Fq '# Flowseal winws .bat -> nfqws2 configuration' "$STAGE/converter.awk" ||
        { error 'Неверный формат AWK-конвертера';return 1; }
    if [ ! -s "$STAGE/hostfakesplit_alt1.hex" ]; then
        error 'Не найден подготовленный Lua hex-файл.'
        return 1
    fi
    if have awk; then
        mkdir "$STAGE/.check" || return 1
        printf 'winws.exe --filter-tcp=443 --dpi-desync=fake\n' > "$STAGE/.check.bat"
        FLOWSEAL_OUTPUT="$STAGE/.check" FLOWSEAL_GAMES=no \
            FLOWSEAL_INTERFACE=eth3 FLOWSEAL_ALT_LUA_HEX=41 \
            awk -f "$STAGE/converter.awk" "$STAGE/.check.bat" >/dev/null 2>&1 &&
            sh -n "$STAGE/.check/nfqws2.conf" || {
                error 'AWK-конвертер не прошёл проверку преобразования.'
                return 1
            }
        rm -rf "$STAGE/.check" "$STAGE/.check.bat"
    fi
    [ ! -e "$RUNTIME/$version" ] && [ ! -L "$RUNTIME/$version" ] || {
        error 'Каталог новой версии уже существует; перезапись запрещена.'
        return 1
    }
    chmod 700 "$STAGE/menu.sh" "$STAGE/flowseal_converter" || return 1
    mv "$STAGE" "$RUNTIME/$version" || return 1
    STAGE=''
    printf '%s\n' "$version" > "$HOME_DIR/.current.$$" || return 1
    mv "$HOME_DIR/.current.$$" "$CURRENT_FILE" || return 1
    [ ! -L "$LAUNCHER" ] || { error 'Символическая ссылка вместо загрузчика';return 1; }
    cp "$RUNTIME/$version/flowseal_converter" "$HOME_DIR/.launcher.$$" &&
        chmod 700 "$HOME_DIR/.launcher.$$" &&
        mv "$HOME_DIR/.launcher.$$" "$LAUNCHER" || return 1
    printf 'Конвертер обновлён: %s\n' "$version"
}
mkdir -p "$RUNTIME" "$HOME_DIR/strategies" || exit 1
[ ! -L "$HOME_DIR" ] && [ ! -L "$RUNTIME" ] &&
    [ ! -L "$HOME_DIR/strategies" ] || {
        error 'Небезопасная символическая ссылка в хранилище.'
        exit 1
    }
read_current
TEMP_FILE=$(mktemp "$HOME_DIR/.flowseal-version.XXXXXX") || exit 1
REMOTE=''
if fetch "$BASE/flowseal.version" "$TEMP_FILE"; then
    IFS= read -r REMOTE < "$TEMP_FILE" || :
    if ! valid_version "$REMOTE"; then error 'Некорректная удалённая версия';REMOTE='';fi
else
    printf 'GitHub недоступен: запускается локальная версия, если она сохранена.\n'
fi
if [ -n "$REMOTE" ] && [ "$REMOTE" != "$CURRENT" ]; then
    install_runtime "$REMOTE" || error 'Обновление не выполнено; локальная версия сохранена.'
    read_current
fi
if [ -z "$CURRENT" ] || [ ! -f "$RUNTIME/$CURRENT/menu.sh" ]; then
    error 'Нет установленного конвертера. Проверьте доступность GitHub.'
    exit 1
fi
export KEENUTILS_FLOWSEAL_HOME="$HOME_DIR"
sh "$RUNTIME/$CURRENT/menu.sh"
