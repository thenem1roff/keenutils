#!/bin/sh

# TorrServer updater for Keenetic + Entware (ARM64)

BIN="/opt/sbin/torrserver"
SERVICE="/opt/etc/init.d/S90torrserver"
BACKUP="/opt/sbin/torrserver.backup"
API="https://api.github.com/repos/YouROK/TorrServer/releases/latest"
API_URL="http://127.0.0.1:8090/echo"

export PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

TMP=""
STOPPED=0

cleanup() {
    [ -z "$TMP" ] || rm -f "$TMP"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

fail() {
    echo "ОШИБКА: $*" >&2
    exit 1
}

version() {
    "$1" --version 2>&1 |
        sed -n 's/.*\(MatriX\.[0-9][0-9.]*\).*/\1/p' |
        head -n 1
}

echo "=== TorrServer Updater ==="

[ "$(uname -m)" = "aarch64" ] ||
    fail "Поддерживается только ARM64"

[ -x "$BIN" ] || fail "TorrServer не найден"
[ -f "$SERVICE" ] || fail "Скрипт службы не найден"

# Install ONLY missing Entware dependencies before the update. Works also
# when called directly as: curl -fsSL .../torrserver | sh
have() { command -v "$1" >/dev/null 2>&1; }
have opkg || fail 'Не найден Entware opkg'
[ "$(id -u)" = 0 ] || fail 'Требуются права root'
INDEX_READY=0
if ! have grep; then
    opkg update || fail 'Не удалось обновить индекс Entware'
    INDEX_READY=1
    opkg install grep || fail 'Не удалось установить grep'
    have grep || fail 'grep недоступен после установки'
fi
# Entware can mark explicitly installed packages as "install user installed".
# Use opkg's installed list instead of assuming a single Status flag.
pkg_installed() {
    opkg list-installed "$1" 2>/dev/null |
        awk -v name="$1" '$1 == name && $2 == "-" { found=1; exit } END { exit !found }'
}
ensure_package() {
    package=$1
    if pkg_installed "$package"; then return 0; fi
    if [ "$INDEX_READY" -eq 0 ]; then
        echo 'Обновление списка пакетов Entware...'
        opkg update || fail 'Не удалось обновить индекс Entware'
        INDEX_READY=1
    fi
    echo "Установка зависимости: $package"
    opkg install "$package" || fail "Не удалось установить $package"
    pkg_installed "$package" || fail "Пакет $package не найден после установки"
}
ensure_command() {
    cmd=$1
    tool_package=$2
    have "$cmd" && return 0
    ensure_package "$tool_package"
    have "$cmd" || fail "Не найдена команда $cmd после установки $tool_package"
}
echo 'Проверка зависимостей TorrServer Updater...'
ensure_package ca-certificates
ensure_command curl curl
ensure_command sed sed
ensure_command head coreutils-head
ensure_command cp coreutils-cp
ensure_command mv coreutils-mv
ensure_command chmod coreutils-chmod
ensure_command mktemp coreutils-mktemp
ensure_command awk gawk
ensure_command date coreutils-date
ensure_command sleep coreutils-sleep
ensure_command rm coreutils-rm
ensure_command pgrep procps-ng-pgrep

CURRENT=$(version "$BIN")
[ -n "$CURRENT" ] ||
    fail "Не удалось определить установленную версию"

echo "Установлена: $CURRENT"
echo "Проверка GitHub..."

RELEASE=$(curl -fsSL --retry 2 \
    --connect-timeout 10 --max-time 30 "$API") ||
    fail "GitHub API недоступен"

LATEST=$(printf '%s\n' "$RELEASE" |
    sed -n 's/^[[:space:]]*"tag_name": *"\([^"]*\)".*/\1/p' |
    head -n 1)

case "$LATEST" in
    MatriX.[0-9]*) ;;
    *) fail "Некорректная версия релиза: $LATEST" ;;
esac

echo "Доступна:    $LATEST"

if [ "$CURRENT" = "$LATEST" ]; then
    echo "TorrServer уже обновлён."
    exit 0
fi

# Сравнение числовых компонентов версии
is_newer() {
    awk -v old="${CURRENT#MatriX.}" \
        -v new="${LATEST#MatriX.}" '
        BEGIN {
            a = split(old, x, ".")
            b = split(new, y, ".")
            n = (a > b ? a : b)
            for (i = 1; i <= n; i++) {
                if ((y[i] + 0) > (x[i] + 0)) exit 0
                if ((y[i] + 0) < (x[i] + 0)) exit 1
            }
            exit 1
        }'
}

if ! is_newer; then
    echo "Установленная версия не старее релиза."
    exit 0
fi

echo "Обновление: $CURRENT -> $LATEST"

TMP=$(mktemp /opt/sbin/.torrserver.XXXXXX) ||
    fail "Не удалось создать временный файл"

URL="https://github.com/YouROK/TorrServer/releases/download/$LATEST/TorrServer-linux-arm64"

echo "Скачивание бинарника..."

curl -fL --retry 3 --connect-timeout 15 \
    --max-time 300 -o "$TMP" "$URL" ||
    fail "Не удалось скачать бинарник"

[ -s "$TMP" ] || fail "Скачанный файл пуст"

chmod 755 "$TMP" || fail "Ошибка chmod"

DOWNLOADED=$(version "$TMP")

[ "$DOWNLOADED" = "$LATEST" ] ||
    fail "Версия скачанного файла не совпадает: $DOWNLOADED"

echo "Бинарник проверен: $DOWNLOADED"

# Резервная копия
echo "Создание резервной копии..."
cp -p "$BIN" "$BACKUP" ||
    fail "Не удалось создать резервную копию"

rollback() {
    echo "Восстановление предыдущей версии..."
    "$SERVICE" stop >/dev/null 2>&1
    cp -p "$BACKUP" "$BIN" ||
        fail "Не удалось восстановить бинарник!"
    "$SERVICE" start
}


echo "Ожидание безопасного момента..."

while :; do
    SEC=$(date +%S)
    case "$SEC" in
        03|33) break ;;
    esac
    sleep 1
done

echo "Остановка TorrServer..."
"$SERVICE" stop ||
    fail "Не удалось остановить службу"

STOPPED=1

echo "Замена бинарника..."
if ! mv -f "$TMP" "$BIN"; then
    rollback
    fail "Ошибка замены бинарника"
fi
TMP=""

echo "Запуск TorrServer..."
"$SERVICE" start

echo "Проверка работоспособности..."

OK=0
i=0

while [ "$i" -lt 10 ]; do
    sleep 2

    RUNNING=$(version "$BIN")
    HTTP_CODE=$(curl -s -o /dev/null \
        -w '%{http_code}' \
        --connect-timeout 2 --max-time 3 \
        "$API_URL")

    if [ "$RUNNING" = "$LATEST" ] &&
       [ "$HTTP_CODE" = "200" ] &&
       pgrep -x torrserver >/dev/null 2>&1; then
        OK=1
        break
    fi

    i=$((i + 1))
done

if [ "$OK" -ne 1 ]; then
    echo "Новая версия не прошла проверку!"
    rollback
    fail "Обновление отменено"
fi

echo ""
echo "================================"
echo "TorrServer успешно обновлён!"
echo "$CURRENT -> $LATEST"
echo "API: HTTP $HTTP_CODE"
echo "================================"
