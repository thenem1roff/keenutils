
#!/bin/sh

# TorrServer updater for Keenetic / Entware
# Architecture: aarch64
# Features: SHA256 verification, versioned backups, rollback.

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

API_URL="https://api.github.com/repos/YouROK/TorrServer/releases/latest"
DOWNLOAD_URL="https://github.com/YouROK/TorrServer/releases/latest/download/TorrServer-linux-arm64"

TARGET_FILE="/opt/sbin/torrserver"
INIT_SCRIPT="/opt/etc/init.d/S90torrserver"
BACKUP_DIR="/opt/sbin/torrserver-backups"
HEALTH_URL="http://127.0.0.1:8090/"
MAX_BACKUPS=3

WORK="/tmp/torr-update-$$"
mkdir -p "$WORK" || exit 1

API_FILE="$WORK/release.json"
NEW_FILE="$WORK/TorrServer-linux-arm64"
INSTALL_TMP="${TARGET_FILE}.new"
RESTORE_TMP="${TARGET_FILE}.restore"

cleanup() {
    rm -rf "$WORK"
    rm -f "$INSTALL_TMP" "$RESTORE_TMP"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

say() { echo "$*"; }

fail() {
    say "[ERROR] $*"
    exit 1
}

# Retry network requests up to 3 times.
fetch() {
    URL="$1"
    OUTPUT="$2"
    ATTEMPT=1

    while [ "$ATTEMPT" -le 3 ]; do
        say "[INFO] Download attempt $ATTEMPT/3"

        if curl -4 -fLsS \
            --connect-timeout 20 \
            --max-time 600 \
            "$URL" -o "$OUTPUT"; then
            [ -s "$OUTPUT" ] && return 0
        fi

        rm -f "$OUTPUT"
        ATTEMPT=$((ATTEMPT + 1))

        if [ "$ATTEMPT" -le 3 ]; then
            sleep 3
        fi
    done

    return 1
}

# Extract numeric version, e.g. MatriX.146.1 -> 146.1
version_number() {
    echo "$1" |
        sed -n 's/.*MatriX\.\([0-9][0-9.]*\).*/\1/p'
}

# Return success when version B is newer than version A.
is_newer() {
    awk -v a="$1" -v b="$2" '
    BEGIN {
        na = split(a, aa, ".")
        nb = split(b, bb, ".")
        n = na > nb ? na : nb

        for (i = 1; i <= n; i++) {
            x = (i <= na ? aa[i] + 0 : 0)
            y = (i <= nb ? bb[i] + 0 : 0)

            if (y > x) exit 0
            if (y < x) exit 1
        }

        exit 1
    }'
}

# 1. Check architecture.
ARCH="$(uname -m)"
[ "$ARCH" = "aarch64" ] ||
    fail "Unsupported architecture: $ARCH"

say "[OK] Architecture: $ARCH"

# 2. Check required commands.
for CMD in curl awk sed grep head sha256sum pidof; do
    command -v "$CMD" >/dev/null 2>&1 ||
        fail "Required command missing: $CMD"
done

# 3. Locate current binary.
if [ ! -f "$TARGET_FILE" ]; then
    TARGET_FILE="$(command -v torrserver 2>/dev/null)"
fi

[ -n "$TARGET_FILE" ] && [ -f "$TARGET_FILE" ] ||
    fail "TorrServer binary not found"

case "$TARGET_FILE" in
    /*) ;;
    *) fail "Unexpected binary path: $TARGET_FILE" ;;
esac

LOCAL_VER="$("$TARGET_FILE" --version 2>/dev/null | head -n 1)"
[ -n "$LOCAL_VER" ] ||
    fail "Cannot determine installed version"

say "[OK] Installed version: $LOCAL_VER"

# 4. Locate service script.
if [ ! -f "$INIT_SCRIPT" ]; then
    INIT_SCRIPT="$(ls /opt/etc/init.d/*torr* 2>/dev/null | head -n 1)"
fi

[ -n "$INIT_SCRIPT" ] && [ -f "$INIT_SCRIPT" ] ||
    fail "TorrServer init script not found"

# 5. Download release metadata.
say "[INFO] Checking GitHub releases..."

fetch "$API_URL" "$API_FILE" ||
    fail "Cannot download GitHub release metadata"

REMOTE_VER="$(grep '"tag_name"' "$API_FILE" |
    head -n 1 | awk -F '"' '{print $4}')"

[ -n "$REMOTE_VER" ] ||
    fail "Cannot determine latest release version"

LOCAL_NUM="$(version_number "$LOCAL_VER")"
REMOTE_NUM="$(version_number "$REMOTE_VER")"

[ -n "$LOCAL_NUM" ] && [ -n "$REMOTE_NUM" ] ||
    fail "Cannot compare versions: $LOCAL_VER / $REMOTE_VER"

say "[OK] GitHub version: $REMOTE_VER"

if [ "$LOCAL_VER" = "$REMOTE_VER" ]; then
    say "[INFO] Already up to date."
    exit 0
fi

if ! is_newer "$LOCAL_NUM" "$REMOTE_NUM"; then
    say "[INFO] Installed version is equal to or newer than the release."
    exit 0
fi

say "----------------------------------------"
say "Installed: $LOCAL_VER"
say "Available: $REMOTE_VER"
say "----------------------------------------"

printf "Continue update? [Y/n]: "
read REPLY < /dev/tty || REPLY="n"

case "$REPLY" in
    [nN]*)
        say "[INFO] Update cancelled."
        exit 0
        ;;
esac

# 6. Extract official SHA256 for the exact asset.
EXPECTED_HASH="$(
    sed -n \
        '/"name": "TorrServer-linux-arm64"/,/"browser_download_url"/p' \
        "$API_FILE" |
    grep '"digest":' |
    head -n 1 |
    sed 's/.*"digest":[[:space:]]*"sha256:\([0-9a-fA-F]*\)".*/\1/'
)"

case "$EXPECTED_HASH" in
    *[!0-9a-fA-F]*|'')
        fail "Official SHA256 digest is missing or invalid."
        ;;
esac

[ "${#EXPECTED_HASH}" -eq 64 ] ||
    fail "Official SHA256 must contain 64 hexadecimal characters."

# 7. Download and verify BEFORE stopping the service.
say "[INFO] Downloading new binary..."

fetch "$DOWNLOAD_URL" "$NEW_FILE" ||
    fail "Binary download failed."

ACTUAL_HASH="$(sha256sum "$NEW_FILE" | awk '{print $1}')"

[ "$ACTUAL_HASH" = "$EXPECTED_HASH" ] ||
    fail "SHA256 mismatch. Existing installation is untouched."

chmod +x "$NEW_FILE" ||
    fail "Cannot set executable permission."

DOWNLOADED_VER="$("$NEW_FILE" --version 2>/dev/null | head -n 1)"

[ -n "$DOWNLOADED_VER" ] ||
    fail "Downloaded binary failed its version check."

say "[OK] SHA256 verified."
say "[OK] Downloaded binary: $DOWNLOADED_VER"

DOWNLOADED_NUM="$(version_number "$DOWNLOADED_VER")"

[ "$DOWNLOADED_VER" = "$REMOTE_VER" ] ||
    fail "Downloaded version does not match GitHub release."

# 8. Create and verify a versioned backup.
mkdir -p "$BACKUP_DIR" ||
    fail "Cannot create backup directory."

LOCAL_TAG="$(echo "$LOCAL_VER" |
    sed -n 's/.*\(MatriX\.[0-9][0-9.]*\).*/\1/p')"

[ -n "$LOCAL_TAG" ] || LOCAL_TAG="unknown"

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_FILE="$BACKUP_DIR/torrserver.${LOCAL_TAG}.${STAMP}"

cp -p "$TARGET_FILE" "$BACKUP_FILE" ||
    fail "Cannot create backup."

ORIGINAL_HASH="$(sha256sum "$TARGET_FILE" | awk '{print $1}')"
BACKUP_HASH="$(sha256sum "$BACKUP_FILE" | awk '{print $1}')"

[ "$ORIGINAL_HASH" = "$BACKUP_HASH" ] ||
    fail "Backup verification failed."

say "[OK] Backup created: $BACKUP_FILE"

# 9. Stop service.
say "[INFO] Stopping TorrServer..."

"$INIT_SCRIPT" stop >/dev/null 2>&1
sleep 2

if pidof torrserver >/dev/null 2>&1 ||
   pidof TorrServer >/dev/null 2>&1; then
    "$INIT_SCRIPT" start >/dev/null 2>&1
    fail "Could not stop TorrServer."
fi

# 10. Install new binary.
if ! cp "$NEW_FILE" "$INSTALL_TMP" ||
   ! chmod +x "$INSTALL_TMP" ||
   ! mv -f "$INSTALL_TMP" "$TARGET_FILE"; then
    "$INIT_SCRIPT" start >/dev/null 2>&1
    fail "Could not install new binary."
fi

# 11. Start service and check HTTP health.
say "[INFO] Starting updated TorrServer..."

"$INIT_SCRIPT" start >/dev/null 2>&1

OK=0
ATTEMPT=1

while [ "$ATTEMPT" -le 5 ]; do
    if { pidof torrserver >/dev/null 2>&1 ||
         pidof TorrServer >/dev/null 2>&1; } &&
       curl -fsS --connect-timeout 2 --max-time 5 \
           "$HEALTH_URL" -o /dev/null; then
        OK=1
        break
    fi

    sleep 2
    ATTEMPT=$((ATTEMPT + 1))
done

# 12. Roll back on failure.
if [ "$OK" -ne 1 ]; then
    say "[ERROR] New version failed health check."
    say "[INFO] Restoring $LOCAL_VER..."

    "$INIT_SCRIPT" stop >/dev/null 2>&1
    sleep 2

    if cp "$BACKUP_FILE" "$RESTORE_TMP" &&
       chmod +x "$RESTORE_TMP" &&
       mv -f "$RESTORE_TMP" "$TARGET_FILE"; then

        "$INIT_SCRIPT" start >/dev/null 2>&1
        sleep 2

        RESTORED_VER="$("$TARGET_FILE" --version 2>/dev/null | head -n 1)"

        if { pidof torrserver >/dev/null 2>&1 ||
             pidof TorrServer >/dev/null 2>&1; } &&
           curl -fsS --connect-timeout 2 --max-time 5 \
               "$HEALTH_URL" -o /dev/null; then
            say "[OK] Rollback successful: $RESTORED_VER"
        else
            say "[CRITICAL] Rollback attempted, but service is unhealthy."
            say "[CRITICAL] Backup preserved: $BACKUP_FILE"
        fi
    else
        say "[CRITICAL] Could not restore backup."
        say "[CRITICAL] Backup preserved: $BACKUP_FILE"
    fi

    exit 1
fi

# 13. Keep the three newest backups ONLY after successful update.
ls -1t "$BACKUP_DIR"/torrserver.* 2>/dev/null |
    awk -v max="$MAX_BACKUPS" 'NR > max { print }' |
    while IFS= read -r OLD_FILE; do
        rm -f "$OLD_FILE"
    done

FINAL_VER="$("$TARGET_FILE" --version 2>/dev/null | head -n 1)"

say "----------------------------------------"
say "[SUCCESS] TorrServer updated."
say "[OK] Version: $FINAL_VER"
say "[OK] HTTP health check passed."
say "[OK] Backup: $BACKUP_FILE"
say "----------------------------------------"

exit 0
