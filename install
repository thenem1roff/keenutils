#!/bin/sh
# KeenUtils Installer: interactive menu for Keenetic + Entware.
# Run from a saved file, not "curl | sh", to preserve interactive stdin.
set -u
export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

BASE_URL="https://raw.githubusercontent.com/thenem1roff/keenutils/main"
INDEX_READY=0
TMP_FILES=""
TORR_AUTHFILE=''
TORR_RESPONSE_FILE=''
TORR_TERMINAL_ECHO_OFF=0

clean_up() {
    for item in $TMP_FILES; do
        [ -f "$item" ] && rm -f "$item"
    done
    # Restore terminal echo on Ctrl-C during password entry.
    if [ "$TORR_TERMINAL_ECHO_OFF" = 1 ]; then stty echo </dev/tty 2>/dev/null || :; fi
    [ -z "$TORR_AUTHFILE" ] || rm -f "$TORR_AUTHFILE"
    [ -z "$TORR_RESPONSE_FILE" ] || rm -f "$TORR_RESPONSE_FILE"
}
trap clean_up EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

say() { printf '%s\n' "$*"; }
err() { printf 'ОШИБКА: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# Always read user answers from a terminal, including when launched from pipe.
if [ ! -t 0 ]; then
    [ -r /dev/tty ] || { err 'Необходим интерактивный терминал.'; exit 1; }
    exec </dev/tty
fi
if ! have opkg || [ ! -d /opt/etc ] || [ ! -d /opt/bin ]; then
    err 'Не найдена рабочая среда Entware в /opt.'
    exit 1
fi
if [ "$(id -u)" != "0" ]; then
    err 'Запустите установщик с правами root в Entware.'
    exit 1
fi
if ! have grep; then
    say 'Установка недостающего grep для проверки пакетов...'
    opkg update && opkg install grep && have grep ||
        { err 'Не удалось установить grep.'; exit 1; }
fi

pause_menu() {
    printf '\nНажмите Enter для возврата в меню... '
    IFS= read -r _pause || :
}
ask_yes() {
    question=$1
    default=$2
    while :; do
        if [ "$default" = yes ]; then
            printf '%s [Y/n]: ' "$question"
        else
            printf '%s [y/N]: ' "$question"
        fi
        IFS= read -r answer || return 1
        case "$answer" in
            '') [ "$default" = yes ]; return $? ;;
            y|Y|yes|YES|Yes) return 0 ;;
            n|N|no|NO|No) return 1 ;;
            *) say 'Введите y или n (Enter — ответ по умолчанию).' ;;
        esac
    done
}
# opkg status can be "install user installed" or "install ok installed".
# Match the package name in the authoritative installed list instead.
pkg_installed() {
    opkg list-installed "$1" 2>/dev/null |
        awk -v name="$1" '$1 == name && $2 == "-" { found=1; exit } END { exit !found }'
}
sync_index() {
    if [ "$INDEX_READY" -eq 0 ]; then
        say 'Обновление списка пакетов Entware...'
        opkg update || { err 'opkg update не выполнен.'; return 1; }
        INDEX_READY=1
    fi
}
install_pkg() {
    package=$1
    if pkg_installed "$package"; then
        say "$package: уже установлен."
        return 0
    fi
    sync_index || return 1
    say "Установка зависимости/пакета: $package"
    opkg install "$package" || return 1
    pkg_installed "$package" || { err "$package отсутствует после установки."; return 1; }
}
ensure_curl() {
    install_pkg ca-certificates && install_pkg curl && have curl
}
ensure_jq() {
    install_pkg jq && have jq
}
ensure_ssl_wget() {
    install_pkg ca-certificates || return 1
    if pkg_installed wget-ssl; then return 0; fi
    if pkg_installed wget-nossl; then
        say 'wget-nossl конфликтует с wget-ssl.'
        ask_yes 'Удалить wget-nossl для HTTPS-репозиториев?' no || return 1
        opkg remove wget-nossl || return 1
    fi
    install_pkg wget-ssl
}
# Install the downloaded installer once so it can be launched as "keenutils".
# Do not silently replace an existing installation; menu item 99 does updates.
KEENUTILS_BIN=/opt/bin/keenutils
valid_keenutils() {
    [ -s "$1" ] && sh -n "$1" >/dev/null 2>&1 &&
        grep -Fq '# KeenUtils Installer:' "$1" &&
        grep -Fq 'torrserver_menu() {' "$1"
}
ensure_mktemp() {
    if ! have mktemp; then
        install_pkg coreutils-mktemp || return 1
        have mktemp || { err 'Не удалось установить mktemp.'; return 1; }
    fi
}
bootstrap_keenutils() {
    case "$0" in
        /opt/bin/keenutils|keenutils) return 0 ;;
    esac
    if [ -e "$KEENUTILS_BIN" ] || [ -L "$KEENUTILS_BIN" ]; then
        valid_keenutils "$KEENUTILS_BIN" ||
            { err "Путь $KEENUTILS_BIN занят другим или повреждённым файлом. Не перезаписываю."; return 1; }
        say 'KeenUtils уже установлен. Для обновления выберите пункт 99.'
        exec "$KEENUTILS_BIN"
    fi
    case "$0" in
        */*) [ -f "$0" ] && [ -r "$0" ] ||
                 { err 'Не найден файл запуска. Скачайте скрипт в файл и запустите через sh.'; return 1; } ;;
        *) err 'Запустите скачанный файл через sh /tmp/keenutils-install.sh (не через wget | sh).'; return 1 ;;
    esac
    valid_keenutils "$0" || { err 'Файл установки не прошёл проверку.'; return 1; }
    ensure_mktemp || return 1
    for cmd in cp mv chmod; do
        have "$cmd" || { err "Не найдена команда $cmd"; return 1; }
    done
    temp=$(mktemp /opt/bin/.keenutils.XXXXXX) || return 1
    if ! cp "$0" "$temp" || ! chmod 755 "$temp" ||
       ! valid_keenutils "$temp"; then
        rm -f "$temp"
        err 'Не удалось подготовить KeenUtils в /opt/bin.'
        return 1
    fi
    if ! mv "$temp" "$KEENUTILS_BIN"; then
        rm -f "$temp"
        err 'Не удалось сохранить /opt/bin/keenutils.'
        return 1
    fi
    [ -x "$KEENUTILS_BIN" ] && valid_keenutils "$KEENUTILS_BIN" ||
        { err 'После установки /opt/bin/keenutils не прошёл проверку.'; return 1; }
    say 'KeenUtils установлен: /opt/bin/keenutils'
    say 'В дальнейшем запускайте меню командой: keenutils'
    exec "$KEENUTILS_BIN"
}
bootstrap_keenutils || exit 1

# Menu item 99: download, validate and atomically replace the installed script.
# Never update packages or the other utilities as a side effect.
KEENUTILS_UPDATED=0
update_keenutils() {
    KEENUTILS_UPDATED=0
    [ -x "$KEENUTILS_BIN" ] && valid_keenutils "$KEENUTILS_BIN" ||
        { err 'KeenUtils не найден или повреждён в /opt/bin/keenutils.'; return 1; }
    ask_yes 'Проверить обновление KeenUtils из GitHub?' yes || return 0
    ensure_mktemp || return 1
    for cmd in mv cp chmod rm; do
        have "$cmd" || { err "Не найдена команда $cmd"; return 1; }
    done
    newfile=$(mktemp /opt/bin/.keenutils.new.XXXXXX) || return 1
    say "Загрузка: $BASE_URL/install"
    download_ok=0
    if have wget && wget -q -O "$newfile" "$BASE_URL/install"; then
        download_ok=1
    else
        if ! have curl; then
            say 'wget недоступен или не поддерживает HTTPS; проверяю curl...'
            ensure_curl || { rm -f "$newfile"; return 1; }
        fi
        if curl -fLSs --retry 2 --connect-timeout 15 --max-time 90 -o "$newfile" "$BASE_URL/install"; then
            download_ok=1
        fi
    fi
    if [ "$download_ok" -ne 1 ] || ! valid_keenutils "$newfile"; then
        rm -f "$newfile"
        err 'Скачанный KeenUtils не прошёл проверку. Установленная версия не изменена.'
        return 1
    fi
    if have cmp && cmp -s "$newfile" "$KEENUTILS_BIN"; then
        rm -f "$newfile"
        say 'KeenUtils уже актуален, обновление не требуется.'
        return 0
    fi
    backup=/opt/bin/keenutils.backup
    if ! cp -p "$KEENUTILS_BIN" "$backup"; then
        rm -f "$newfile"
        err 'Не удалось создать резервную копию. Обновление отменено.'
        return 1
    fi
    if ! chmod 755 "$newfile" || ! mv -f "$newfile" "$KEENUTILS_BIN"; then
        rm -f "$newfile"
        err 'Не удалось установить обновление. Исходный файл сохранён.'
        return 1
    fi
    if ! [ -x "$KEENUTILS_BIN" ] || ! valid_keenutils "$KEENUTILS_BIN"; then
        cp -p "$backup" "$KEENUTILS_BIN" ||
            err "Не удалось восстановить KeenUtils! Резервная копия: $backup"
        err 'Новая версия не прошла проверку, выполнен откат.'
        return 1
    fi
    say 'KeenUtils успешно обновлён.'
    say "Резервная копия: $backup"
    KEENUTILS_UPDATED=1
}

# Central catalog is loaded on demand. Never execute sources.conf as shell code.
# The catalog may change URLs only within known upstream repositories.
SOURCES_CACHE=/opt/etc/keenutils/sources.conf
SOURCES_READY=0
SOURCE_URL=''
SOURCE_MIRROR=''
source_url_allowed() {
    src_key=$1
    src_address=$2
    # Reject untrusted schemes, query strings, whitespace and path traversal.
    case "$src_address" in
        https://*) ;;
        *) return 1 ;;
    esac
    case "$src_address" in
        *..*|*[!a-zA-Z0-9._/:@+-]*) return 1 ;;
    esac
    case "$src_key:$src_address" in
        nfqws_feed:https://nfqws.github.io/nfqws-keenetic/*|\
        nfqws2_feed:https://nfqws.github.io/nfqws2-keenetic/*|\
        nfqws_web_feed:https://nfqws.github.io/nfqws-keenetic-web/*|\
        nfqws_menu:https://raw.githubusercontent.com/rndnaame/nfqws-menu/*|\
        nfqws_menu:https://cdn.jsdelivr.net/gh/rndnaame/nfqws-menu@*|\
        keenkit:https://raw.githubusercontent.com/spatiumstas/KeenKit/*|\
        keenkit:https://cdn.jsdelivr.net/gh/spatiumstas/KeenKit@*|\
        hydra:https://git.zerrolabs.org/Ground-Zerro/release/*|\
        awg:https://raw.githubusercontent.com/hoaxisr/awg-manager/*|\
        awg:https://cdn.jsdelivr.net/gh/hoaxisr/awg-manager@*|\
        torrserver:https://raw.githubusercontent.com/thenem1roff/keenutils/*|\
        torrserver:https://cdn.jsdelivr.net/gh/thenem1roff/keenutils@*|\
        torr_watchdog:https://raw.githubusercontent.com/thenem1roff/keenutils/*|\
        torr_watchdog:https://cdn.jsdelivr.net/gh/thenem1roff/keenutils@*)
            return 0 ;;
    esac
    return 1
}
sources_validate() {
    [ -s "$1" ] || return 1
    # Every known entry is mandatory, unique and must be owned by its upstream.
    for src_key in nfqws_feed nfqws2_feed nfqws_web_feed nfqws_menu \
                   keenkit hydra awg torrserver torr_watchdog; do
        src_found=$(awk -F '|' -v key="$src_key" '$1==key{n++}END{print n+0}' "$1")
        [ "$src_found" = 1 ] || return 1
    done
    while IFS='|' read -r src_key src_primary src_backup src_extra ||
          [ -n "$src_key" ]; do
        case "$src_key" in ''|\#*) continue ;; esac
        [ -z "$src_extra" ] && [ -n "$src_primary" ] || return 1
        source_url_allowed "$src_key" "$src_primary" || return 1
        if [ -n "$src_backup" ]; then
            source_url_allowed "$src_key" "$src_backup" || return 1
        fi
    done < "$1"
}
sources_refresh() {
    if [ "$SOURCES_READY" -eq 1 ]; then return 0; fi
    mkdir -p /opt/etc/keenutils || return 1
    ensure_mktemp || return 1
    src_temp=$(mktemp /opt/etc/keenutils/.sources.XXXXXX) || return 1
    src_ok=0
    if have wget && wget -q -O "$src_temp" "$BASE_URL/sources.conf"; then
        src_ok=1
    elif have curl && curl -fLSs --connect-timeout 5 --max-time 20 \
                         -o "$src_temp" "$BASE_URL/sources.conf"; then
        src_ok=1
    fi
    if [ "$src_ok" -eq 1 ] && sources_validate "$src_temp"; then
        chmod 600 "$src_temp" && mv -f "$src_temp" "$SOURCES_CACHE" ||
            { rm -f "$src_temp"; err 'Не удалось сохранить каталог источников.'; return 1; }
        say 'Список официальных источников обновлён.'
    else
        rm -f "$src_temp"
        if ! sources_validate "$SOURCES_CACHE"; then
            err 'Не удалось получить проверенный sources.conf, локальной копии нет.'
            return 1
        fi
        say 'GitHub недоступен: используется последний проверенный sources.conf.'
    fi
    SOURCES_READY=1
}
source_get() {
    sources_refresh || return 1
    SOURCE_URL=$(awk -F '|' -v key="$1" '$1==key {print $2; exit}' "$SOURCES_CACHE")
    SOURCE_MIRROR=$(awk -F '|' -v key="$1" '$1==key {print $3; exit}' "$SOURCES_CACHE")
    [ -n "$SOURCE_URL" ] || return 1
}
# Download an upstream script only to a temporary file; never pipe it into sh.
source_download_once() {
    src_attempt_url=$1
    src_attempt_dest=$2
    if have wget && wget -q -O "$src_attempt_dest" "$src_attempt_url" &&
        [ -s "$src_attempt_dest" ]; then
        return 0
    fi
    if have curl && curl -fLSs --connect-timeout 15 --max-time 90 --retry 2 \
        -o "$src_attempt_dest" "$src_attempt_url" && [ -s "$src_attempt_dest" ]; then
        return 0
    fi
    return 1
}
source_download() {
    source_get "$1" || return 1
    src_destination=$2
    say "Источник: $SOURCE_URL"
    source_download_once "$SOURCE_URL" "$src_destination" && return 0
    if [ -n "$SOURCE_MIRROR" ]; then
        say "Резервный официальный адрес: $SOURCE_MIRROR"
        source_download_once "$SOURCE_MIRROR" "$src_destination" && return 0
    fi
    err 'Ни один проверенный источник установщика не ответил.'
    return 1
}

repo_add() {
    name=$1
    feed=$2
    path="/opt/etc/opkg/$name.conf"
    line="src/gz $name $feed"
    mkdir -p /opt/etc/opkg || return 1
    if [ -e "$path" ]; then
        grep -Fqx "$line" "$path" && return 0
        err "В $path есть другая конфигурация. Не перезаписываю."
        return 1
    fi
    printf '%s\n' "$line" > "$path" || return 1
    INDEX_READY=0
    say "Добавлен репозиторий: $name"
}
fetch_and_run() {
    fetch_key=$1
    fetch_label=$2
    ask_yes "Скачать и запустить официальный установщик $fetch_label?" yes ||
        { say 'Действие отменено.'; return 2; }
    ensure_mktemp || return 1
    fetch_temp=$(mktemp /tmp/keenutils.XXXXXX) || return 1
    TMP_FILES="$TMP_FILES $fetch_temp"
    source_download "$fetch_key" "$fetch_temp" ||
        { err 'Не удалось скачать установщик.'; return 1; }
    sh -n "$fetch_temp" ||
        { err 'Скрипт содержит ошибку синтаксиса sh.'; return 1; }
    sh "$fetch_temp"
}
install_nfqws() {
    if pkg_installed nfqws-keenetic; then say 'nfqws уже установлен.'; return 0; fi
    if pkg_installed nfqws2-keenetic; then
        err 'Установлен nfqws2. Эти пакеты конфликтуют. Автоудаление запрещено.'
        return 1
    fi
    ask_yes 'Продолжить установку nfqws?' yes || return 0
    ensure_ssl_wget || return 1
    source_get nfqws_feed || return 1
    repo_add nfqws-keenetic "$SOURCE_URL" || return 1
    install_pkg nfqws-keenetic || return 1
    [ -f /opt/etc/nfqws/nfqws.conf ] ||
        { err 'Не найден ожидаемый /opt/etc/nfqws/nfqws.conf'; return 1; }
    say 'nfqws: пакет и конфигурация найдены.'
}
install_nfqws2() {
    if pkg_installed nfqws2-keenetic; then say 'nfqws2 уже установлен.'; return 0; fi
    if pkg_installed nfqws-keenetic; then
        err 'Установлен nfqws. Для перехода требуется отдельная ручная миграция.'
        return 1
    fi
    ensure_ssl_wget || return 1
    source_get nfqws2_feed || return 1
    repo_add nfqws2-keenetic "$SOURCE_URL" || return 1
    install_pkg nfqws2-keenetic || return 1
    [ -f /opt/etc/nfqws2/nfqws2.conf ] ||
        { err 'Не найден ожидаемый /opt/etc/nfqws2/nfqws2.conf'; return 1; }
    say 'nfqws2: пакет и конфигурация найдены.'
}
install_nfqws_web() {
    if pkg_installed nfqws-keenetic-web; then say 'nfqws-web уже установлен.'; return 0; fi
    if ! pkg_installed nfqws-keenetic && ! pkg_installed nfqws2-keenetic; then
        say 'Внимание: сначала рекомендуется установить nfqws или nfqws2.'
        ask_yes 'Продолжить без nfqws?' yes || return 0
    fi
    ensure_ssl_wget || return 1
    source_get nfqws_web_feed || return 1
    repo_add nfqws-keenetic-web "$SOURCE_URL" || return 1
    install_pkg nfqws-keenetic-web || return 1
    [ -f /opt/etc/nfqws_web.conf ] ||
        { err 'Не найден ожидаемый /opt/etc/nfqws_web.conf'; return 1; }
    say 'nfqws-web установлен. Интерфейс обычно доступен на порту 90.'
}
# Launch the original upstream menu without copying its strategy implementation.
# Updates of that menu remain the responsibility of its own author.
launch_nfqws_menu() {
    nm_target=/opt/nfqws-menu.sh
    if [ -f "$nm_target" ]; then
        [ -s "$nm_target" ] && sh -n "$nm_target" ||
            { err 'Существующий /opt/nfqws-menu.sh повреждён. Не перезаписываю.'; return 1; }
        say 'Запуск уже установленного nfqws-menu.'
    else
        ask_yes 'Установить оригинальный nfqws-menu автора rndnaame?' yes || return 0
        ensure_mktemp || return 1
        nm_temp=$(mktemp /opt/.nfqws-menu.XXXXXX) || return 1
        if ! source_download nfqws_menu "$nm_temp" || ! sh -n "$nm_temp"; then
            rm -f "$nm_temp"
            err 'Скрипт nfqws-menu не скачан или не прошёл проверку синтаксиса.'
            return 1
        fi
        if ! chmod 755 "$nm_temp" || ! mv "$nm_temp" "$nm_target"; then
            rm -f "$nm_temp"
            err 'Не удалось сохранить nfqws-menu.'
            return 1
        fi
    fi
    # The upstream menu handles its own updates, strategies and backups.
    sh "$nm_target"
}

install_keenkit() {
    if [ -f /opt/keenkit.sh ] && [ -e /opt/bin/keenkit ]; then
        say 'KeenKit уже установлен.'
        return 0
    fi
    fetch_and_run keenkit KeenKit || return 1
    if [ -f /opt/keenkit.sh ] && [ -e /opt/bin/keenkit ]; then
        say 'KeenKit установлен в /opt/keenkit.sh и /opt/bin/keenkit.'
    else
        err 'KeenKit не найден в ожидаемых каталогах (или установка отменена).'
        return 1
    fi
}
install_hydra() {
    if pkg_installed hrneo && pkg_installed hrweb; then
        say 'HydraRoute Neo и HRweb уже установлены.'
        return 0
    fi
    if pkg_installed hrneo && ! pkg_installed hrweb; then
        say 'HydraRoute Neo установлен; отсутствует только HRweb.'
        install_pkg hrweb || return 1
        pkg_installed hrweb || return 1
        say 'HRweb установлен.'
        return 0
    fi
    say 'Требуется KeeneticOS новее 4.3.6 и компонент Xtables-addons для Netfilter.'
    ask_yes 'Вы проверили требования HydraRoute Neo?' yes || return 0
    fetch_and_run hydra HydraRoute-Neo || return 1
    if pkg_installed hrneo && pkg_installed hrweb &&
       [ -f /opt/etc/HydraRoute/hrneo.conf ] && have hrneo; then
        say 'HydraRoute Neo и HRweb установлены (интерфейс: порт 2000).'
        say 'Конфиг: /opt/etc/HydraRoute/hrneo.conf'
    else
        err 'Не обнаружены оба ожидаемых пакета hrneo и hrweb.'
        return 1
    fi
}
install_awg() {
    if pkg_installed awg-manager; then say 'AWG Manager уже установлен.'; return 0; fi
    say 'Требуется компонент WireGuard в KeeneticOS.'
    ask_yes 'Компонент WireGuard установлен?' yes || return 0
    fetch_and_run awg AWG-Manager || return 1
    pkg_installed awg-manager ||
        { err 'Пакет awg-manager не найден после установки (или установка отменена).'; return 1; }
    [ -d /opt/etc/awg-manager ] ||
        { err 'Не найден ожидаемый каталог /opt/etc/awg-manager.'; return 1; }
    say 'AWG Manager установлен (интерфейс: обычно порт 2222).'
}
torr_present() {
    pkg_installed torrserver || [ -x /opt/sbin/torrserver ]
}
torr_service() {
    TORR_INIT=''
    for init in /opt/etc/init.d/S*torrserver*; do
        if [ -x "$init" ]; then TORR_INIT=$init; break; fi
    done
    [ -n "$TORR_INIT" ]
}
# Find the actual USB volume hosting Entware. /opt may be a symlink or bind mount.
filesystem_id() {
    fs_real=$1
    if have readlink; then
        fs_real=$(readlink -f "$1" 2>/dev/null) || fs_real=$1
    fi
    if have stat; then
        fs_value=$(stat -c %d "$fs_real" 2>/dev/null)
        if [ -n "$fs_value" ]; then
            printf 'dev:%s\n' "$fs_value"
            return 0
        fi
    fi
    fs_value=$(df -P "$fs_real" 2>/dev/null | awk 'NR == 2 {print $1}')
    [ -n "$fs_value" ] || return 1
    printf 'source:%s\n' "$fs_value"
}
is_mounted_disk() {
    [ -d "$1" ] && [ -r /proc/mounts ] &&
        awk -v p="$1" '$2 == p {found=1} END {exit !found}' /proc/mounts
}
verify_entware_disk() {
    check_disk=$1
    case "$check_disk" in /tmp/mnt/*) ;; *) return 1 ;; esac
    volname=$(printf '%s\n' "$check_disk" | cut -d / -f4)
    [ "$check_disk" = "/tmp/mnt/$volname" ] || return 1
    is_mounted_disk "$check_disk" || return 1
    disk_id=$(filesystem_id "$check_disk") || return 1
    [ "$disk_id" = "$OPT_FS_ID" ] && [ -w "$check_disk" ]
}
find_entware_disk() {
    DISK_ROOT=''
    OPT_FS_ID=$(filesystem_id /opt) ||
        { err 'Не удалось определить файловую систему /opt.'; return 1; }
    say "Файловая система Entware: $OPT_FS_ID"
    if have readlink; then
        real_opt=$(readlink -f /opt 2>/dev/null) || real_opt=''
        case "$real_opt" in
            /tmp/mnt/*)
                volume=$(printf '%s\n' "$real_opt" | cut -d / -f4)
                candidate="/tmp/mnt/$volume"
                if verify_entware_disk "$candidate"; then DISK_ROOT=$candidate; fi
                ;;
        esac
    fi
    if [ -z "$DISK_ROOT" ]; then
        for candidate in /tmp/mnt/*; do
            verify_entware_disk "$candidate" || continue
            if [ -n "$DISK_ROOT" ] && [ "$DISK_ROOT" != "$candidate" ]; then
                err 'Обнаружено несколько томов с файловой системой /opt.'
                DISK_ROOT=''
                break
            fi
            DISK_ROOT=$candidate
        done
    fi
    if [ -n "$DISK_ROOT" ]; then
        say "Накопитель Entware: $DISK_ROOT"
        return 0
    fi
    err 'Автоматически определить накопитель не удалось.'
    say 'Диагностика:'
    df -h /opt 2>&1 || :
    say 'Доступные монтирования /tmp/mnt:'
    awk '$2 ~ /^\/tmp\/mnt\/[^\/]+$/ {print "  " $2 " (" $1 ")"}' /proc/mounts
    printf 'Введите путь /tmp/mnt/<том> (Enter — отмена): '
    IFS= read -r candidate || return 1
    [ -n "$candidate" ] || return 1
    if verify_entware_disk "$candidate"; then
        DISK_ROOT=$candidate
        return 0
    fi
    err 'Указанный путь не является проверенным накопителем Entware.'
    return 1
}

# POST /settings supports HTTP Basic Auth and may take longer than 15 s
# because a settings change reconnects torrent sessions. No service stop needed.
TORR_API_URL='http://127.0.0.1:8090/settings'
TORR_AUTHFILE=''
TORR_RESPONSE_FILE=''
TORR_HTTP_STATUS=''
TORR_CURRENT_SETTINGS=''
TORR_TERMINAL_ECHO_OFF=0

torr_api_cleanup() {
    [ -z "$TORR_AUTHFILE" ] || rm -f "$TORR_AUTHFILE"
    [ -z "$TORR_RESPONSE_FILE" ] || rm -f "$TORR_RESPONSE_FILE"
    TORR_AUTHFILE=''
    TORR_RESPONSE_FILE=''
}
torr_api_call() {
    api_json=$1
    TORR_HTTP_STATUS=''
    if [ -n "$TORR_AUTHFILE" ]; then
        TORR_HTTP_STATUS=$(curl -sS -K "$TORR_AUTHFILE" -o "$TORR_RESPONSE_FILE" \
            -w '%{http_code}' --connect-timeout 5 --max-time 90 \
            -H 'Content-Type: application/json' \
            -d "$api_json" "$TORR_API_URL") ||
            { err 'API TorrServer недоступен.'; return 1; }
    else
        TORR_HTTP_STATUS=$(curl -sS -o "$TORR_RESPONSE_FILE" \
            -w '%{http_code}' --connect-timeout 5 --max-time 90 \
            -H 'Content-Type: application/json' \
            -d "$api_json" "$TORR_API_URL") ||
            { err 'API TorrServer недоступен.'; return 1; }
    fi
    [ "$TORR_HTTP_STATUS" = 200 ] ||
        { err "API TorrServer: HTTP $TORR_HTTP_STATUS"; return 1; }
}
get_torr_settings() {
    torr_api_call '{"action":"get"}' || return 1
    TORR_CURRENT_SETTINGS=$(cat "$TORR_RESPONSE_FILE") || return 1
    printf '%s' "$TORR_CURRENT_SETTINGS" |
        jq -e 'type=="object" and has("UseDisk") and
               has("TorrentsSavePath") and
               (.UseDisk|type=="boolean") and
               (.TorrentsSavePath|type=="string")' >/dev/null ||
        { err 'API не вернул поля UseDisk/TorrentsSavePath.'; return 1; }
}
set_torr_settings() {
    req=$(printf '%s' "$1" | jq -c '{action:"set",sets:.}') || return 1
    torr_api_call "$req"
}
prompt_torr_auth() {
    ask_yes 'TorrServer требует HTTP-авторизацию. Ввести данные?' yes || return 1
    printf 'Логин: '
    IFS= read -r auth_user || return 1
    [ -n "$auth_user" ] || { err 'Пустой логин.'; return 1; }
    have stty || { err 'stty не найден, пароль не запрашиваю.'; return 1; }
    printf 'Пароль: '
    stty -echo </dev/tty || return 1
    TORR_TERMINAL_ECHO_OFF=1
    IFS= read -r auth_pass
    auth_status=$?
    stty echo </dev/tty || :
    TORR_TERMINAL_ECHO_OFF=0
    printf '\n'
    [ "$auth_status" -eq 0 ] || return 1
    TORR_AUTHFILE=$(mktemp /tmp/.keenutils-auth.XXXXXX) || return 1
    chmod 600 "$TORR_AUTHFILE" || return 1
    auth_line=$(jq -cn --arg cred "$auth_user:$auth_pass" '$cred') || return 1
    unset auth_pass auth_user
    printf 'user = %s\n' "$auth_line" > "$TORR_AUTHFILE"
}
configure_torr_cache_inner() {
    if ! get_torr_settings; then
        if [ "$TORR_HTTP_STATUS" = 401 ]; then
            prompt_torr_auth || return 1
            get_torr_settings || { err 'Не удалось войти в API TorrServer.'; return 1; }
        else
            err 'Невозможно прочитать настройки через API. Ничего не меняю.'
            return 1
        fi
    fi
    existing=$TORR_CURRENT_SETTINGS
    old_path=$(printf '%s' "$existing" | jq -r '.TorrentsSavePath') || return 1
    old_disk=$(printf '%s' "$existing" | jq -r '.UseDisk') || return 1
    say "Сейчас: $old_path (UseDisk=$old_disk)"
    find_entware_disk || return 1
    CACHE_DIR="$DISK_ROOT/tscashe"
    say "Предлагается: $CACHE_DIR"
    if [ "$old_path" = "$CACHE_DIR" ] && [ "$old_disk" = true ]; then
        say 'Кеш уже настроен по этому пути. Изменений не требуется.'
        return 0
    fi
    say 'При сохранении TorrServer переподключает торрент-сессии.'
    ask_yes 'Изменить настройки дискового кеша?' yes || return 0
    mkdir -p "$CACHE_DIR" || return 1
    probe="$CACHE_DIR/.keenutils-check.$$"
    if ! ( : > "$probe" ); then
        err 'Каталог кеша недоступен для записи.'
        return 1
    fi
    rm -f "$probe"
    backup_dir=/opt/var/backups/keenutils
    mkdir -p "$backup_dir" || return 1
    backup=$(mktemp "$backup_dir/torr-settings.XXXXXX") || return 1
    chmod 600 "$backup" || return 1
    printf '%s\n' "$existing" > "$backup" || return 1
    say "Резервная копия настроек: $backup"
    updated=$(printf '%s' "$existing" |
        jq -c --arg p "$CACHE_DIR" '.TorrentsSavePath=$p | .UseDisk=true') ||
        return 1
    if ! set_torr_settings "$updated"; then
        err "Сохранение не подтверждено API. Копия: $backup"
        return 1
    fi
    attempts=0
    while [ "$attempts" -lt 3 ]; do
        if get_torr_settings; then
            new_path=$(printf '%s' "$TORR_CURRENT_SETTINGS" |
                jq -r '.TorrentsSavePath') || return 1
            new_disk=$(printf '%s' "$TORR_CURRENT_SETTINGS" |
                jq -r '.UseDisk') || return 1
            if [ "$new_path" = "$CACHE_DIR" ] && [ "$new_disk" = true ]; then
                say "УСПЕХ: UseDisk=true, путь кеша: $new_path"
                say 'Настройка подтверждена повторным чтением из TorrServer.'
                return 0
            fi
        fi
        attempts=$((attempts + 1))
        sleep 2
    done
    err 'TorrServer не подтвердил новую настройку (возможен режим read-only).'
    err "Прежний путь: $old_path; требуемый: $CACHE_DIR"
    err "Резервная копия: $backup"
    return 1
}
configure_torr_cache() {
    ensure_curl && ensure_jq || return 1
    ensure_mktemp || return 1
    TORR_AUTHFILE=''
    TORR_RESPONSE_FILE=$(mktemp /tmp/.keenutils-settings.XXXXXX) || return 1
    configure_torr_cache_inner
    res=$?
    torr_api_cleanup
    return "$res"
}
watchdog_complete() {
    [ -x /opt/bin/torr_watchdog.sh ] &&
    sh -n /opt/bin/torr_watchdog.sh >/dev/null 2>&1 &&
    [ -f /opt/etc/crontab ] && have grep &&
    grep -Fqx '* * * * * root /opt/bin/torr_watchdog.sh' /opt/etc/crontab &&
    grep -Fqx '* * * * * root sleep 30 && /opt/bin/torr_watchdog.sh' /opt/etc/crontab ||
        return 1
    for required in curl pgrep killall awk wc tail sync mkdir rm rmdir \
        ls head cat sleep date; do
        have "$required" || return 1
    done
    for init in /opt/etc/init.d/S*cron*; do
        [ -x "$init" ] && return 0
    done
    return 1
}
install_watchdog() {
    # Independent pre-check: a complete installation is never run again.
    if watchdog_complete; then
        say 'TorrServer watchdog уже установлен и прописан в Cron (00 и 30 сек).'
        return 0
    fi
    if [ -e /opt/bin/torr_watchdog.sh ]; then
        say 'Watchdog найден, но проверка файла или Cron неполная.'
    else
        say 'Watchdog пока не установлен.'
    fi
    torr_service || { err 'Служба TorrServer не найдена.'; return 1; }
    # The standalone installer installs missing dependencies, including Cron.
    fetch_and_run torr_watchdog TorrServer-watchdog || return 1
    # Independent post-check after the external installer exits.
    watchdog_complete ||
        { err 'После установки не проверены исполняемый watchdog и обе задачи Cron.'; return 1; }
    say 'Watchdog проверен: файл, синтаксис, обе задачи Cron.'
}
# Install only TorrServer via opkg. Other actions live in the submenu.
install_torrserver() {
    if torr_present; then
        say 'TorrServer уже установлен; повторная установка не требуется.'
    else
        install_pkg torrserver || return 1
    fi
    [ -x /opt/sbin/torrserver ] ||
        { err 'Нет исполняемого /opt/sbin/torrserver.'; return 1; }
    torr_service || { err 'Не найден исполняемый init-скрипт TorrServer.'; return 1; }
    say 'TorrServer установлен: бинарник и служба проверены.'
}

update_torrserver() {
    [ -x /opt/sbin/torrserver ] ||
        { err 'TorrServer не установлен. Сначала выберите пункт 1.'; return 1; }
    torr_service || { err 'Не найден init-скрипт TorrServer.'; return 1; }
    [ "$(uname -m)" = aarch64 ] ||
        { err 'Обновлятор TorrServer поддерживает только aarch64.'; return 1; }
    fetch_and_run torrserver TorrServer-updater || return 1
    [ -x /opt/sbin/torrserver ] && torr_service ||
        { err 'Не удалось проверить TorrServer после обновления.'; return 1; }
    say 'TorrServer: проверка бинарника и службы после обновления выполнена.'
}

setup_torr_cache() {
    [ -x /opt/sbin/torrserver ] ||
        { err 'TorrServer не установлен. Сначала выберите пункт 1.'; return 1; }
    torr_service || { err 'Не найден init-скрипт TorrServer.'; return 1; }
    configure_torr_cache
}

# Nested menu: each operation is independent. 0 returns directly to main.
torrserver_menu() {
    while :; do
        printf '\033[2J\033[H'
        say '============================================='
        say '         TorrServer | Управление'
        say '============================================='
        say '  1. Установить TorrServer'
        say '  2. Обновить TorrServer'
        say '  3. Установить / проверить watchdog'
        say '  4. Настроить кеш TorrServer'
        say ''
        say '  0. Назад в главное меню'
        say '---------------------------------------------'
        printf 'Выберите действие: '
        IFS= read -r torr_choice || return 0
        case "$torr_choice" in
            1|01) install_torrserver ;;
            2|02) update_torrserver ;;
            3|03) install_watchdog ;;
            4|04) setup_torr_cache ;;
            ''|0|00) return 0 ;;
            *) say 'Неизвестный пункт меню.' ;;
        esac
        pause_menu
    done
}
# Menu 88: removal is explicit, offline, and independent of installation.
# No generic "rm dependencies": only known application-specific paths can
# be cleaned, and only after the owning package has been uninstalled.
u_label() {
    case "$1" in
        nfqws) say 'nfqws' ;;
        nfqws2) say 'nfqws2' ;;
        nfqws-web) say 'nfqws-web' ;;
        nfqws-menu) say 'nfqws-menu' ;;
        keenkit) say 'KeenKit' ;;
        hydra) say 'HydraRoute Neo' ;;
        awg) say 'AWG Manager' ;;
        torrserver) say 'TorrServer' ;;
        torr-watchdog) say 'TorrServer watchdog' ;;
    esac
}
u_cron_has_watchdog() {
    [ -f /opt/etc/crontab ] &&
        grep -Fq '/opt/bin/torr_watchdog.sh' /opt/etc/crontab
}
u_watchdog_present() {
    [ -e /opt/bin/torr_watchdog.sh ] || [ -L /opt/bin/torr_watchdog.sh ] ||
        u_cron_has_watchdog
}
u_torr_cache_path() {
    U_CACHE=''
    OPT_FS_ID=$(filesystem_id /opt) || return 1
    for U_CANDIDATE in /tmp/mnt/*; do
        verify_entware_disk "$U_CANDIDATE" || continue
        [ -d "$U_CANDIDATE/tscashe" ] || continue
        if [ -n "$U_CACHE" ]; then
            U_CACHE=''
            return 1
        fi
        U_CACHE="$U_CANDIDATE/tscashe"
    done
    [ -n "$U_CACHE" ]
}
# nfqws-menu creates this launcher when started. Only the exact symlink is
# owned by nfqws-menu; a different link or a regular file is never ours.
u_nfqws_menu_launcher() {
    [ -L /opt/bin/menu ] || return 1
    U_MENU_LINK=$(readlink /opt/bin/menu 2>/dev/null) || return 1
    [ "$U_MENU_LINK" = /opt/nfqws-menu.sh ]
}
# Exact allowlist of application-owned residue paths. Never accept user input
# as a deletion path, and do not remove shared Entware libraries.
u_paths() {
    case "$1" in
        nfqws)
            printf '%s\n' /opt/etc/nfqws /opt/etc/opkg/nfqws-keenetic.conf ;;
        nfqws2)
            printf '%s\n' /opt/etc/nfqws2 /opt/etc/opkg/nfqws2-keenetic.conf ;;
        nfqws-web)
            printf '%s\n' /opt/etc/nfqws_web.conf /opt/etc/opkg/nfqws-keenetic-web.conf ;;
        nfqws-menu)
            printf '%s\n' /opt/etc/nfqws-menu /opt/etc/nfqws-menu.lang
            # Also detect a dangling launcher left by earlier KeenUtils versions.
            if u_nfqws_menu_launcher; then printf '%s\n' /opt/bin/menu; fi ;;
        keenkit)
            # Only the script and its official launcher are managed here.
            printf '%s\n' /opt/keenkit.sh /opt/bin/keenkit ;;
        hydra)
            printf '%s\n' /opt/etc/HydraRoute ;;
        awg)
            printf '%s\n' /opt/etc/awg-manager ;;
        torrserver)
            printf '%s\n' /opt/etc/torrserver /opt/sbin/torrserver \
                /opt/etc/init.d/S90torrserver
            if u_torr_cache_path; then printf '%s\n' "$U_CACHE"; fi ;;
        torr-watchdog)
            printf '%s\n' /opt/bin/torr_watchdog.sh ;;
    esac
}
u_detect() {
    U_INSTALLED=0
    U_LEFT=0
    case "$1" in
        nfqws) pkg_installed nfqws-keenetic && U_INSTALLED=1 ;;
        nfqws2) pkg_installed nfqws2-keenetic && U_INSTALLED=1 ;;
        nfqws-web) pkg_installed nfqws-keenetic-web && U_INSTALLED=1 ;;
        nfqws-menu) [ -s /opt/nfqws-menu.sh ] && U_INSTALLED=1 ;;
        keenkit) [ -f /opt/keenkit.sh ] && U_INSTALLED=1 ;;
        hydra)
            if pkg_installed hrneo || pkg_installed hrweb; then U_INSTALLED=1; fi ;;
        awg) pkg_installed awg-manager && U_INSTALLED=1 ;;
        torrserver) pkg_installed torrserver && U_INSTALLED=1 ;;
        torr-watchdog) u_watchdog_present && U_INSTALLED=1 ;;
    esac
    for U_CHECK_PATH in $(u_paths "$1"); do
        if [ -e "$U_CHECK_PATH" ] || [ -L "$U_CHECK_PATH" ]; then
            U_LEFT=1
            break
        fi
    done
    if [ "$1" = torrserver ] && u_watchdog_present; then U_LEFT=1; fi
}
u_show_status() {
    u_detect "$1"
    say "Программа: $(u_label "$1")"
    if [ "$U_INSTALLED" -eq 1 ]; then
        say 'Установка: обнаружена.'
    elif [ "$U_LEFT" -eq 1 ]; then
        say 'Программа удалена или установлена не через opkg; остались файлы.'
    else
        say 'Программа и известные остатки не обнаружены.'
    fi
    say 'Обнаруженные файлы и каталоги:'
    U_FOUND=0
    for U_SHOW_PATH in $(u_paths "$1"); do
        if [ -e "$U_SHOW_PATH" ] || [ -L "$U_SHOW_PATH" ]; then
            say "  $U_SHOW_PATH"
            U_FOUND=1
        fi
    done
    [ "$U_FOUND" -eq 1 ] || say '  (нет)'
    if [ "$1" = torrserver ] && u_watchdog_present; then
        say 'Watchdog: обнаружен (управляется отдельно).'
    fi
    if [ "$1" = torr-watchdog ] && u_cron_has_watchdog; then
        say 'Cron: найдены задания запуска watchdog.'
    fi
    case "$1" in
        nfqws|nfqws2)
            say 'Пользовательские политики KeeneticOS штатный postrm не удаляет.' ;;
        hydra)
            say 'Полный hr-uninstall.sh может затронуть Xray, AdGuardHome и другие пакеты.'
            say 'KeenUtils намеренно НЕ выполняет эту опасную очистку.' ;;
        awg) say 'VPN-ключи и конфигурации удаляются только отдельным пунктом 2.' ;;
        torrserver)
            say 'Кеш на неизвестных дисках автоматически не удаляется.' ;;
    esac
}
u_keenkit_launcher() {
    [ -L /opt/bin/keenkit ] || return 1
    U_LINK=$(readlink /opt/bin/keenkit 2>/dev/null) || return 1
    [ "$U_LINK" = /opt/keenkit.sh ]
}
u_remove_keenkit() {
    if [ -f /opt/keenkit.sh ]; then
        rm -f /opt/keenkit.sh || return 1
    fi
    if u_keenkit_launcher; then
        rm -f /opt/bin/keenkit || return 1
    elif [ -e /opt/bin/keenkit ] || [ -L /opt/bin/keenkit ]; then
        say 'Неизвестная команда /opt/bin/keenkit оставлена (назначение не совпадает).'
    fi
    say 'KeenKit: файлы скрипта удалены, другие установленные им программы сохранены.'
}
u_remove_nfqws_menu() {
    if u_nfqws_menu_launcher; then
        rm -f /opt/bin/menu || return 1
    fi
    rm -f /opt/nfqws-menu.sh || return 1
    say 'Скрипт и его штатная команда menu удалены. Стратегии и установленные пакеты nfqws сохранены.'
}
# Disable only the two exact watchdog cron entries. Other Cron jobs are
# untouched. Unknown watchdog entries prevent unsafe partial removal.
u_disable_watchdog() {
    if [ -f /opt/etc/crontab ]; then
        U_CRON_A='* * * * * root /opt/bin/torr_watchdog.sh'
        U_CRON_B='* * * * * root sleep 30 && /opt/bin/torr_watchdog.sh'
        if awk -v a="$U_CRON_A" -v b="$U_CRON_B" \
            'index($0,"/opt/bin/torr_watchdog.sh") && $0!=a && $0!=b {found=1}
             END{exit !found}' /opt/etc/crontab; then
            err 'В Cron есть нестандартные задания watchdog. Нужна ручная проверка.'
            return 1
        fi
        ensure_mktemp || return 1
        mkdir -p /opt/var/backups/keenutils || return 1
        U_CRON_BACKUP=$(mktemp /opt/var/backups/keenutils/crontab-before-remove.XXXXXX) ||
            return 1
        cp -p /opt/etc/crontab "$U_CRON_BACKUP" ||
            { err 'Не удалось сохранить резервную копию Cron.'; return 1; }
        U_CRON_TMP=$(mktemp /opt/etc/.keenutils-cron.XXXXXX) || return 1
        if ! awk -v a="$U_CRON_A" -v b="$U_CRON_B" \
            '$0!=a && $0!=b {print}' /opt/etc/crontab > "$U_CRON_TMP"; then
            rm -f "$U_CRON_TMP"
            return 1
        fi
        if ! cat "$U_CRON_TMP" > /opt/etc/crontab; then
            cp -p "$U_CRON_BACKUP" /opt/etc/crontab || :
            rm -f "$U_CRON_TMP"
            err 'Не удалось обновить Cron; использована резервная копия.'
            return 1
        fi
        rm -f "$U_CRON_TMP"
        say "Резервная копия Cron: $U_CRON_BACKUP"
    fi
    if [ -e /opt/bin/torr_watchdog.sh ] || [ -L /opt/bin/torr_watchdog.sh ]; then
        rm -f /opt/bin/torr_watchdog.sh || return 1
    fi
    say 'Watchdog и его штатные задания Cron удалены.'
}
u_remove() {
    U_REMOVE_ID=$1
    u_detect "$U_REMOVE_ID"
    if [ "$U_INSTALLED" -eq 0 ]; then
        say 'Программа как установленная не обнаружена. Проверьте пункт 2 (остатки).'
        return 0
    fi
    say "Выбрано удаление: $(u_label "$U_REMOVE_ID")"
    case "$U_REMOVE_ID" in
        nfqws|nfqws2)
            say 'Авторский postrm предложит удалить списки и конфигурацию (y/N).'
            say 'При ответе y будет удалён ВЕСЬ каталог настроек.'
            ;;
        hydra)
            say 'Стандартное удаление hrweb/hrneo через opkg.'
            say 'Опасный полный hr-uninstall.sh запускаться НЕ будет.'
            ;;
        awg) say 'Конфигурация и VPN-ключи останутся до отдельной очистки.' ;;
        torrserver)
            if u_watchdog_present; then
                say 'Для удаления TorrServer сначала необходимо отключить его watchdog.'
                say 'Будут удалены только скрипт watchdog и две штатные строки Cron.'
                ask_yes 'Отключить watchdog для удаления TorrServer?' no || return 0
            fi ;;
    esac
    ask_yes "Продолжить удаление $(u_label "$U_REMOVE_ID")?" no || return 0
    case "$U_REMOVE_ID" in
        nfqws) opkg remove --autoremove nfqws-keenetic || return 1 ;;
        nfqws2) opkg remove --autoremove nfqws2-keenetic || return 1 ;;
        nfqws-web) opkg remove --autoremove nfqws-keenetic-web || return 1 ;;
        nfqws-menu) u_remove_nfqws_menu || return 1 ;;
        keenkit) u_remove_keenkit || return 1 ;;
        hydra)
            # Official standard removal. Remove UI before its backend; do not
            # invoke the upstream full cleanup that removes unrelated packages.
            if pkg_installed hrweb; then opkg remove hrweb || return 1; fi
            if pkg_installed hrneo; then opkg remove hrneo || return 1; fi
            ;;
        awg) opkg remove awg-manager || return 1 ;;
        torr-watchdog) u_disable_watchdog || return 1 ;;
        torrserver)
            if u_watchdog_present; then u_disable_watchdog || return 1; fi
            if torr_service; then
                "$TORR_INIT" stop ||
                    say 'Служба не подтвердила остановку. Проверьте процессы после удаления.'
            fi
            opkg remove torrserver || {
                err 'Не удалось удалить TorrServer. Watchdog оставлен выключенным.'
                return 1
            }
            ;;
    esac
    u_detect "$U_REMOVE_ID"
    if [ "$U_INSTALLED" -eq 1 ]; then
        err 'Удаление не подтверждено: программа по-прежнему обнаруживается.'
        return 1
    fi
    say 'Штатное удаление завершено. Для проверки остатков используйте пункт 2.'
}
u_cleanup_guard() {
    # Extra safety if opkg metadata is broken but a service is still present.
    case "$1" in
        nfqws)
            if [ -x /opt/etc/init.d/S51nfqws ]; then
                err 'Найдена служба nfqws: нельзя очищать её конфигурацию.'
                return 1
            fi ;;
        nfqws2)
            if [ -x /opt/etc/init.d/S51nfqws2 ]; then
                err 'Найдена служба nfqws2: нельзя очищать её конфигурацию.'
                return 1
            fi ;;
        hydra)
            if [ -x /opt/etc/init.d/S99hrneo ]; then
                err 'Найдена служба HydraRoute: очистка заблокирована.'
                return 1
            fi ;;
        awg)
            if [ -x /opt/etc/init.d/S99awg-manager ]; then
                err 'Найдена служба AWG Manager: очистка заблокирована.'
                return 1
            fi ;;
    esac
    return 0
}
u_cleanup() {
    U_CLEAN_ID=$1
    u_detect "$U_CLEAN_ID"
    if [ "$U_INSTALLED" -eq 1 ]; then
        err 'Сначала удалите программу (пункт 1); чистить файлы действующей программы нельзя.'
        return 1
    fi
    u_cleanup_guard "$U_CLEAN_ID" || return 1
    if [ "$U_LEFT" -eq 0 ]; then
        say 'Известных остатков не обнаружено.'
        return 0
    fi
    U_CLEAN_PATHS=''
    for U_CP in $(u_paths "$U_CLEAN_ID"); do
        if [ -e "$U_CP" ] || [ -L "$U_CP" ]; then
            if [ "$U_CLEAN_ID" = keenkit ] && [ "$U_CP" = /opt/bin/keenkit ] &&
                ! u_keenkit_launcher; then
                say 'Неизвестный /opt/bin/keenkit пропущен (ссылка не на официальный скрипт).'
                continue
            fi
            U_CLEAN_PATHS="$U_CLEAN_PATHS $U_CP"
        fi
    done
    if [ "$U_CLEAN_ID" = torrserver ] && u_watchdog_present; then
        say 'Обнаружен watchdog. Отключить его можно в «Связанные программы».'
    fi
    if [ -z "$U_CLEAN_PATHS" ]; then
        say 'Безопасных для автоматической очистки файлов не обнаружено.'
        return 0
    fi
    say 'Будут БЕЗВОЗВРАТНО удалены только следующие пути:'
    for U_CP in $U_CLEAN_PATHS; do say "  $U_CP"; done
    if [ "$U_CLEAN_ID" = awg ]; then
        say 'ВНИМАНИЕ: каталог содержит VPN-ключи и настройки!'
    fi
    if [ "$U_CLEAN_ID" = torrserver ]; then
        say 'ВНИМАНИЕ: может быть удалён кеш торрентов на подключённом накопителе!'
        if have pgrep && pgrep -x torrserver >/dev/null 2>&1; then
            err 'TorrServer ещё запущен; сначала остановите службу.'
            return 1
        fi
    fi
    ask_yes 'Безвозвратно удалить перечисленные остатки?' no || return 0
    for U_CP in $U_CLEAN_PATHS; do
        # Revalidate the launcher after confirmation: never erase a foreign menu.
        if [ "$U_CLEAN_ID" = nfqws-menu ] && [ "$U_CP" = /opt/bin/menu ] &&
           ! u_nfqws_menu_launcher; then
            say 'Чужая команда /opt/bin/menu сохранена.'
            continue
        fi
        rm -rf "$U_CP" || { err "Не удалось удалить $U_CP"; return 1; }
        say "Удалено: $U_CP"
    done
}
u_linked() {
    U_JUMP=''
    case "$1" in
        nfqws|nfqws2) U_REL_IDS='nfqws-web nfqws-menu' ;;
        nfqws-web|nfqws-menu) U_REL_IDS='nfqws nfqws2 nfqws-web' ;;
        torrserver) U_REL_IDS='torr-watchdog' ;;
        torr-watchdog) U_REL_IDS='torrserver' ;;
        *) U_REL_IDS='' ;;
    esac
    U_REL_SHOW=''
    U_REL_COUNT=0
    say 'Связанные программы (удаляются только отдельно):'
    for U_REL_ID in $U_REL_IDS; do
        [ "$U_REL_ID" = "$1" ] && continue
        u_detect "$U_REL_ID"
        if [ "$U_INSTALLED" -eq 1 ] || [ "$U_LEFT" -eq 1 ]; then
            U_REL_COUNT=$((U_REL_COUNT + 1))
            say " $U_REL_COUNT. $(u_label "$U_REL_ID")"
            U_REL_SHOW="$U_REL_SHOW $U_REL_ID"
        fi
    done
    if [ "$1" = hydra ]; then
        say 'hrweb входит в тот же набор HydraRoute; остальные зависимости общие.'
    fi
    if [ "$U_REL_COUNT" -eq 0 ]; then
        say 'Связанных программ из списка KeenUtils не обнаружено.'
        return 0
    fi
    say ' 0. Назад'
    printf 'Выберите программу для управления: '
    IFS= read -r U_REL_SELECTION || return 0
    case "$U_REL_SELECTION" in ''|0|00) return 0 ;; esac
    U_I=0
    for U_REL_ID in $U_REL_SHOW; do
        U_I=$((U_I + 1))
        if [ "$U_REL_SELECTION" = "$U_I" ]; then
            U_JUMP=$U_REL_ID
            return 0
        fi
    done
    say 'Неизвестный пункт.'
}
u_detail_menu() {
    U_DETAIL_ID=$1
    while :; do
        u_detect "$U_DETAIL_ID"
        printf '\033[2J\033[H'
        say '============================================='
        say "       $(u_label "$U_DETAIL_ID") | Удаление"
        say '============================================='
        if [ "$U_INSTALLED" -eq 1 ]; then
            say 'Статус: установлен'
        elif [ "$U_LEFT" -eq 1 ]; then
            say 'Статус: удалён, остались файлы'
        else
            say 'Статус: не обнаружен'
        fi
        say ' 1. Удалить программу'
        say ' 2. Найти и удалить остатки файлов'
        say ' 3. Связанные программы'
        say ' 4. Проверить состояние'
        say ''
        say ' 0. Назад'
        say '---------------------------------------------'
        printf 'Выберите действие: '
        IFS= read -r U_ACTION || return 0
        case "$U_ACTION" in
            1|01) u_remove "$U_DETAIL_ID" ;;
            2|02) u_cleanup "$U_DETAIL_ID" ;;
            3|03)
                u_linked "$U_DETAIL_ID"
                if [ -n "$U_JUMP" ]; then
                    U_DETAIL_ID=$U_JUMP
                    continue
                fi
                ;;
            4|04) u_show_status "$U_DETAIL_ID" ;;
            ''|0|00) return 0 ;;
            *) say 'Неизвестный пункт.' ;;
        esac
        pause_menu
    done
}
# Self-uninstall removes only KeenUtils-owned installed files.
# Cron, opkg packages, other utilities and their backups are never modified.
# Running a shell script on Linux can safely unlink its own script file;
# the already-open shell continues through the final exit and EXIT trap.
uninstall_keenutils() {
    if [ -L "$KEENUTILS_BIN" ] || ! [ -f "$KEENUTILS_BIN" ] ||
       ! valid_keenutils "$KEENUTILS_BIN"; then
        err 'Установленный KeenUtils не подтверждён; автоматическое удаление отменено.'
        return 1
    fi
    # Refuse to follow unusual links or remove a foreign backup.
    if [ -L /opt/etc/keenutils ] ||
       [ -L /opt/etc/keenutils/sources.conf ] ||
       [ -L /opt/bin/keenutils.backup ]; then
        err 'Обнаружены нестандартные символьные ссылки в файлах KeenUtils.'
        err 'Удаление остановлено, чтобы не затронуть чужие данные.'
        return 1
    fi
    if [ -e /opt/bin/keenutils.backup ] &&
       ! valid_keenutils /opt/bin/keenutils.backup; then
        err 'Резервная копия /opt/bin/keenutils.backup не похожа на KeenUtils.'
        err 'Не удаляю неизвестный файл.'
        return 1
    fi
    if [ -e /opt/etc/keenutils/sources.conf ] &&
       ! [ -f /opt/etc/keenutils/sources.conf ]; then
        err 'Неизвестный тип файла sources.conf: удаление остановлено.'
        return 1
    fi
    KU_TEMP_INSTALL=''
    if [ -f /tmp/keenutils-install.sh ] &&
       [ ! -L /tmp/keenutils-install.sh ] &&
       valid_keenutils /tmp/keenutils-install.sh; then
        KU_TEMP_INSTALL=/tmp/keenutils-install.sh
    fi
    say '============================================='
    say '          Полное удаление KeenUtils'
    say '============================================='
    say 'Будут удалены только собственные файлы KeenUtils:'
    say "  $KEENUTILS_BIN"
    if [ -f /opt/bin/keenutils.backup ]; then
        say '  /opt/bin/keenutils.backup'
    fi
    if [ -f /opt/etc/keenutils/sources.conf ]; then
        say '  /opt/etc/keenutils/sources.conf'
    fi
    if [ -n "$KU_TEMP_INSTALL" ]; then
        say "  $KU_TEMP_INSTALL"
    fi
    say '  /opt/etc/keenutils/ (только если каталог пуст)'
    say ''
    say 'Будут СОХРАНЕНЫ:'
    say '  Все установленные программы, настройки, Cron и watchdog.'
    say '  /opt/var/backups/keenutils/ — копии настроек TorrServer и Cron.'
    say ''
    say 'История терминала, системные журналы, снимки диска и удалённые'
    say 'данные не затрагиваются. Отсутствие исторических следов не гарантируется.'
    say ''
    ask_yes 'Удалить KeenUtils и закрыть меню?' no || {
        say 'Удаление отменено.'
        return 0
    }
    # Remove app-owned auxiliary files first. No glob-based or recursive deletion.
    if [ -f /opt/bin/keenutils.backup ]; then
        rm -f /opt/bin/keenutils.backup ||
            { err 'Не удалось удалить резервную копию KeenUtils.'; return 1; }
    fi
    if [ -f /opt/etc/keenutils/sources.conf ]; then
        rm -f /opt/etc/keenutils/sources.conf ||
            { err 'Не удалось удалить каталог источников KeenUtils.'; return 1; }
    fi
    if [ -d /opt/etc/keenutils ]; then
        if ! rmdir /opt/etc/keenutils 2>/dev/null; then
            say 'В /opt/etc/keenutils остались другие файлы: каталог сохранён.'
        fi
    fi
    # Only remove the shared backup DIRECTORY when already empty.
    # Never erase TorrServer or Cron backups stored inside it.
    if [ -d /opt/var/backups/keenutils ]; then
        if ! rmdir /opt/var/backups/keenutils 2>/dev/null; then
            say 'Резервные копии других настроек сохранены в /opt/var/backups/keenutils/.'
        fi
    fi
    if [ -n "$KU_TEMP_INSTALL" ]; then
        rm -f "$KU_TEMP_INSTALL" ||
            { err 'Не удалось удалить временный установщик.'; return 1; }
    fi
    rm -f "$KEENUTILS_BIN" || {
        err 'Не удалось удалить /opt/bin/keenutils. Удаление неполное.'
        return 1
    }
    say 'KeenUtils удалён. Остальные программы и их данные не изменены.'
    say 'Работа меню завершена.'
    exit 0
}
uninstall_menu() {
    while :; do
        printf '\033[2J\033[H'
        say '============================================='
        say '          Удаление программ'
        say '============================================='
        U_LIST=''
        U_COUNT=0
        for U_SCAN_ID in nfqws nfqws2 nfqws-web nfqws-menu \
                         keenkit hydra awg torrserver torr-watchdog; do
            u_detect "$U_SCAN_ID"
            if [ "$U_INSTALLED" -eq 1 ] || [ "$U_LEFT" -eq 1 ]; then
                U_COUNT=$((U_COUNT + 1))
                if [ "$U_INSTALLED" -eq 1 ]; then
                    U_STATE='Установлен'
                else
                    U_STATE='Остались файлы'
                fi
                say " $U_COUNT. $(u_label "$U_SCAN_ID") [$U_STATE]"
                U_LIST="$U_LIST $U_SCAN_ID"
            fi
        done
        if [ -f "$KEENUTILS_BIN" ] && valid_keenutils "$KEENUTILS_BIN"; then
            U_COUNT=$((U_COUNT + 1))
            say " $U_COUNT. KeenUtils [Установлен]"
            U_LIST="$U_LIST keenutils"
        fi
        if [ "$U_COUNT" -eq 0 ]; then
            say 'Установленные программы и известные остатки не найдены.'
        fi
        say ''
        say ' 0. Назад в главное меню'
        say '---------------------------------------------'
        printf 'Выберите действие: '
        IFS= read -r U_PICK || return 0
        case "$U_PICK" in ''|0|00) return 0 ;; esac
        U_I=0
        U_TARGET=''
        for U_SCAN_ID in $U_LIST; do
            U_I=$((U_I + 1))
            if [ "$U_PICK" = "$U_I" ]; then
                U_TARGET=$U_SCAN_ID
                break
            fi
        done
        if [ -n "$U_TARGET" ]; then
            if [ "$U_TARGET" = keenutils ]; then
                uninstall_keenutils
            else
                u_detail_menu "$U_TARGET"
            fi
        else
            say 'Неизвестный пункт.'
            pause_menu
        fi
    done
}

# Compact status header. Local status is refreshed on each main-menu redraw.
ROUTER_MODEL='Keenetic'
KEENUTILS_UPDATE_STATE='unknown'
UI_BLUE=''
UI_GREEN=''
UI_YELLOW=''
UI_RESET=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    UI_BLUE=$(printf '\033[1;36m')
    UI_GREEN=$(printf '\033[0;32m')
    UI_YELLOW=$(printf '\033[1;33m')
    UI_RESET=$(printf '\033[0m')
fi
router_detect_once() {
    if have ndmc; then
        detected_model=$(ndmc -c 'show version' 2>/dev/null |
            awk '/^[[:space:]]*model:[[:space:]]*/ {
                sub(/^[^:]*:[[:space:]]*/, ""); print; exit
            }')
        if [ -n "$detected_model" ]; then
            case "$detected_model" in
                Keenetic*) ROUTER_MODEL=$detected_model ;;
                *) ROUTER_MODEL="Keenetic $detected_model" ;;
            esac
        fi
    fi
}
# One HTTPS attempt, timeout <= 5s, only at startup; never on redraw.
# Byte-for-byte cmp needs no sha256sum or additional package.
check_keenutils_update_once() {
    KEENUTILS_UPDATE_STATE='unknown'
    [ "${KEENUTILS_DISABLE_UPDATE_CHECK:-0}" = 1 ] && return 0
    [ -r "$KEENUTILS_BIN" ] || return 0
    have cmp && have mktemp || return 0
    update_probe=$(mktemp /tmp/.keenutils-check.XXXXXX) || return 0
    TMP_FILES="$TMP_FILES $update_probe"
    downloaded=0
    if have curl; then
        curl -fsSL --connect-timeout 2 --max-time 5 \
            -o "$update_probe" "$BASE_URL/install" >/dev/null 2>&1 && downloaded=1
    elif have wget; then
        wget -q -T 5 -O "$update_probe" "$BASE_URL/install" >/dev/null 2>&1 &&
            downloaded=1
    fi
    if [ "$downloaded" -eq 1 ] && valid_keenutils "$update_probe"; then
        if cmp -s "$update_probe" "$KEENUTILS_BIN"; then
            KEENUTILS_UPDATE_STATE='current'
        else
            KEENUTILS_UPDATE_STATE='available'
        fi
    fi
    rm -f "$update_probe"
}
# Gather the installed package names in one opkg read per menu display.
header_has_pkg() {
    case "$HEADER_PACKAGE_NAMES" in
        *" $1 "*) return 0 ;;
    esac
    return 1
}
header_add_app() {
    if [ -z "$HEADER_LINE" ]; then
        HEADER_LINE="  $1"
    else
        header_candidate="$HEADER_LINE  ·  $1"
        header_bytes=$(printf '%s' "$header_candidate" | wc -c)
        if [ "$header_bytes" -gt 64 ]; then
            printf '%s%s%s\n' "$UI_GREEN" "$HEADER_LINE" "$UI_RESET"
            HEADER_LINE="  $1"
        else
            HEADER_LINE=$header_candidate
        fi
    fi
}
show_installed_header() {
    HEADER_PACKAGE_NAMES=$(opkg list-installed 2>/dev/null |
        awk '$2 == "-" {printf " %s", $1} END {print " "}')
    HEADER_LINE=''
    printf '%sУстановлены:%s\n' "$UI_GREEN" "$UI_RESET"
    header_has_pkg nfqws-keenetic && header_add_app nfqws
    header_has_pkg nfqws2-keenetic && header_add_app nfqws2
    header_has_pkg nfqws-keenetic-web && header_add_app nfqws-web
    [ -s /opt/nfqws-menu.sh ] && header_add_app nfqws-menu
    [ -f /opt/keenkit.sh ] && header_add_app KeenKit
    if header_has_pkg hrneo || header_has_pkg hrweb; then
        header_add_app 'HydraRoute Neo'
    fi
    header_has_pkg awg-manager && header_add_app 'AWG Manager'
    if header_has_pkg torrserver || [ -x /opt/sbin/torrserver ]; then
        if u_watchdog_present; then
            header_add_app 'TorrServer (+ watchdog)'
        else
            header_add_app TorrServer
        fi
    elif u_watchdog_present; then
        header_add_app 'watchdog (без TorrServer)'
    fi
    if [ -z "$HEADER_LINE" ]; then
        say '  Поддерживаемые приложения не обнаружены'
    else
        printf '%s%s%s\n' "$UI_GREEN" "$HEADER_LINE" "$UI_RESET"
    fi
}
menu() {
    printf '\033[2J\033[H'
    printf '%s%s%s\n' "$UI_BLUE" '========================================' "$UI_RESET"
    printf '%s%s%s\n' "$UI_BLUE" '         KeenUtils | Entware' "$UI_RESET"
    printf '%s%s%s\n' "$UI_BLUE" '========================================' "$UI_RESET"
    say "$ROUTER_MODEL | $(uname -m)"
    say '----------------------------------------'
    show_installed_header
    if [ "$KEENUTILS_UPDATE_STATE" = available ]; then
        say '----------------------------------------'
        printf '%s%s%s\n' "$UI_YELLOW" 'Доступно обновление KeenUtils → 99' "$UI_RESET"
    fi
    say '----------------------------------------'
    say '  1. nfqws'
    say '  2. nfqws2'
    say '  3. nfqws-web'
    say '  4. nfqws-menu'
    say '  5. KeenKit'
    say '  6. HydraRoute Neo'
    say '  7. AWG Manager'
    say '  8. TorrServer'
    say ''
    say ' 88. Удаление программ'
    say ' 99. Обновить KeenUtils'
    say ' 00. Выход'
    say '----------------------------------------'
    printf 'Выберите действие: '
}
router_detect_once
check_keenutils_update_once
while :; do
    menu
    IFS= read -r choice || break
    case "$choice" in
        1|01) install_nfqws ;;
        2|02) install_nfqws2 ;;
        3|03) install_nfqws_web ;;
        4|04) launch_nfqws_menu ;;
        5|05) install_keenkit ;;
        6|06) install_hydra ;;
        7|07) install_awg ;;
        8|08) torrserver_menu; continue ;;
        88) uninstall_menu; continue ;;
        99) update_keenutils
            if [ "$KEENUTILS_UPDATED" -eq 1 ]; then
                say 'Нажмите Enter, чтобы открыть обновлённое меню.'
                IFS= read -r _restart || :
                exec "$KEENUTILS_BIN"
            fi
            ;;
        ''|00|0) say 'Выход.'; break ;;
        *) say 'Неизвестный пункт меню.' ;;
    esac
    pause_menu
done
